# Routine, reviewable repository work. Rules match command prefixes.
prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "show"], decision = "allow")
prefix_rule(pattern = ["git", "fetch"], decision = "allow")
prefix_rule(pattern = ["git", "pull", "--ff-only"], decision = "allow")
prefix_rule(pattern = ["git", "add"], decision = "allow")
prefix_rule(pattern = ["git", "commit"], decision = "allow")
prefix_rule(pattern = ["git", "worktree", "add"], decision = "allow")
prefix_rule(pattern = ["git", "worktree", "list"], decision = "allow")
prefix_rule(pattern = ["git", "push", "origin"], decision = "allow")
prefix_rule(pattern = ["git", "reset"], decision = "prompt")
prefix_rule(pattern = ["git", "clean"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "--force"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "--force-with-lease"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "-f"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "--force"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "--force-with-lease"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "-f"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "--delete"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "-d"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "main", "--force"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "main", "--force-with-lease"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "main", "-f"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "master", "--force"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "master", "--force-with-lease"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "master", "-f"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "HEAD", "--force"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "HEAD", "--force-with-lease"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "origin", "HEAD", "-f"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "-u", "origin", "main", "--force"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "-u", "origin", "main", "--force-with-lease"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "-u", "origin", "main", "-f"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "--set-upstream", "origin", "main", "--force"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "--set-upstream", "origin", "main", "--force-with-lease"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "--set-upstream", "origin", "main", "-f"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "--delete", "origin"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "-d", "origin"], decision = "prompt")

prefix_rule(pattern = ["gh", "pr", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "checks"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "create"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "edit"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "merge", "--admin"], decision = "prompt")
prefix_rule(pattern = ["gh", "pr", "merge", "--squash", "--admin"], decision = "prompt")
prefix_rule(pattern = ["gh", "pr", "merge", "--merge", "--admin"], decision = "prompt")
prefix_rule(pattern = ["gh", "pr", "merge", "--rebase", "--admin"], decision = "prompt")
prefix_rule(pattern = ["gh", "issue", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "edit"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "close"], decision = "allow")
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "repo", "delete"], decision = "prompt")
prefix_rule(pattern = ["gh", "run", "view"], decision = "allow")
