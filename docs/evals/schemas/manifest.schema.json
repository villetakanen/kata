{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.example/schemas/manifest.schema.json",
  "title": "Kata evaluation attempt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "run_id", "case", "task", "condition", "tool", "prompt", "lys_snapshot", "output_dir"],
  "properties": {
    "protocol": {"const": "kata-eval/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "brief", "answer_key"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "brief": {"$ref": "#/$defs/frozenFile"},
        "answer_key": {"$ref": "#/$defs/frozenFile"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience_question", "constraints"],
      "properties": {
        "audience_question": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "condition": {"enum": ["plain-lys", "kata-0.1.0", "kata-candidate"]},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requested_version", "model", "settings"],
      "properties": {
        "id": {"enum": ["claude", "codex", "pi"]},
        "requested_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "settings": {"type": "object"}
      }
    },
    "prompt": {"$ref": "#/$defs/frozenFile"},
    "skill_snapshot": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "directory", "files"],
          "properties": {
            "revision": {"type": "string", "minLength": 1},
            "directory": {"type": "string", "minLength": 1},
            "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frozenFile"}}
          }
        }
      ]
    },
    "lys_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "directory", "files"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "directory": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frozenFile"}}
      }
    },
    "output_dir": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "frozenFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
