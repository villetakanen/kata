from pathlib import Path
import json
root=Path('.')
css=(root/'inputs/lys/lys.css').read_text()
js=(root/'inputs/lys/lys.iife.js').read_text()
html='''<"'!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Retrofit barriers and service turnaround</title>
<style>
'"'''+css+'''
</style>
<style>
:root { color-scheme: light; --ink:#162b33; --muted:#53686f; --paper:#f3f6f4; --panel:#ffffff; --teal:#176b66; --line:#d5e1de; --amber:#9b5814; }
* { box-sizing:border-box; }
html, body { margin:0; background:var(--paper); color:var(--ink); font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }
[data-lys] { --lys-backdrop:var(--paper); --lys-aspect-ratio:16 / 9; --lys-slide-padding:clamp(24px,4.2cqi,64px); --lys-font-size-base:clamp(14px,1.4cqi,20px); --lys-slide-max-width:100vw; --lys-slide-max-height:100vh; }
[data-lys] > article { background:var(--paper); color:var(--ink); }
.slide { display:flex; flex-direction:column; gap:clamp(14px,2.3cqi,28px); }
.kicker { margin:0; color:var(--teal); font-size:.72em; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
h1 { margin:0; max-width:1050px; font-size:clamp(30px,4.1cqi,60px); line-height:1.04; letter-spacing:-.045em; }
.deck-sub { margin:0; color:var(--muted); font-size:1em; line-height:1.4; }
.evidence { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.panel { background:var(--panel); border:1px solid var(--line); border-radius:18px; padding:clamp(16px,2.2cqi,28px); min-width:0; }
.panel-head { display:flex; align-items:baseline; justify-content:space-between; gap:12px; padding-bottom:12px; border-bottom:1px solid var(--line); }
h2 { margin:0; font-size:1.1em; letter-spacing:-.02em; }
.tag { color:var(--muted); font-size:.72em; font-weight:700; text-align:right; }
.metric { margin:16px 0 8px; display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
.metric strong { font-size:clamp(32px,4cqi,56px); line-height:1; letter-spacing:-.05em; color:var(--teal); }
.metric span { font-size:.88em; color:var(--muted); }
.panel p { margin:8px 0 0; line-height:1.4; font-size:.86em; }
.panel .qual { color:var(--amber); font-weight:650; }
.small-list { margin:10px 0 0; padding-left:1.15em; font-size:.82em; line-height:1.45; }
.answerability { display:grid; grid-template-columns: minmax(210px,.72fr) 1.7fr; gap:20px; align-items:center; background:#e4efec; border-radius:18px; padding:18px 24px; }
.answerability h2 { color:var(--teal); font-size:1em; }
.answerability p { margin:5px 0 0; font-size:.78em; color:var(--muted); line-height:1.35; }
.needs { display:flex; flex-wrap:wrap; gap:8px; }
.need { border:1px solid #bfd3ce; background:#f7fbf9; color:var(--ink); border-radius:999px; padding:7px 11px; font-size:.72em; line-height:1.2; }
footer { margin-top:auto; border-top:1px solid var(--line); padding-top:10px; display:flex; justify-content:space-between; gap:12px; color:var(--muted); font-size:.65em; }
@media (max-width:600px) {
  [data-lys] { --lys-aspect-ratio:390 / 844; --lys-slide-padding:20px; --lys-font-size-base:16px; }
  [data-lys] > article { width:100vw; height:100vh; max-height:100vh; aspect-ratio:auto; overflow:auto; }
  .slide { gap:14px; }
  h1 { font-size:31px; line-height:1.06; }
  .deck-sub { font-size:.88em; }
  .evidence { grid-template-columns:1fr; gap:10px; }
  .panel { border-radius:14px; padding:14px 16px; }
  .panel-head { padding-bottom:8px; }
  .metric { margin:10px 0 4px; }
  .metric strong { font-size:38px; }
  .panel p { font-size:.79em; margin-top:5px; }
  .small-list { font-size:.76em; margin-top:6px; }
  .answerability { display:block; padding:14px 16px; border-radius:14px; }
  .needs { margin-top:10px; gap:6px; }
  .need { font-size:.68em; padding:6px 9px; }
  footer { font-size:.58em; }
}
@media print {
  :root { --paper:#fff; }
  [data-lys] > article { width:100%; height:auto; max-height:none; aspect-ratio:16 / 9; overflow:visible; }
  .slide { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
}
</style>
</head>
<body>
<div data-lys aria-label=\"Retrofit program evidence\">
  <article class=\"slide\" aria-label=\"Evidence and limitations\" data-notes=\"North: 40 homeowners completed a survey; they could select multiple barriers. Installer scheduling 28, upfront cost 17, unclear eligibility 9. Counts overlap. South: 15 open support cases reviewed, but total homeowners served is unknown. Nine cases mentioned waiting for an installer; other barriers were not recorded. Turnaround median was 8 days for 11 cases, with 4 times missing. The note ‘around two weeks last spring’ has no identified cases, sample size, or method. Sources have no shared period definition, common denominator, or comparable baseline.\">
    <p class=\"kicker\">Program leads · intake evidence</p>
    <h1>We can’t identify the overall barrier or confirm faster service.</h1>
    <p class=\"deck-sub\">The two partner summaries use different populations and methods, so their counts cannot establish an overall ranking or a change over time.</p>
    <div class=\"evidence\">
      <section class=\"panel\" aria-labelledby=\"north-title\">
        <div class=\"panel-head\"><h2 id=\"north-title\">Partner North</h2><span class=\"tag\">Homeowner survey · n=40</span></div>
        <div class=\"metric\"><strong>28</strong><span>selected installer scheduling</span></div>
        <p>Also selected: <b>upfront cost 17</b>; <b>unclear eligibility 9</b>.</p>
        <p class=\"qual\">Multiple selections allowed: categories overlap, so counts are not parts of a whole.</p>
        <p>No service-turnaround times were included.</p>
      </section>
      <section class=\"panel\" aria-labelledby=\"south-title\">
        <div class=\"panel-head\"><h2 id=\"south-title\">Partner South</h2><span class=\"tag\">Open case review · 15 cases</span></div>
        <div class=\"metric\"><strong>9</strong><span>cases mentioned waiting for an installer</span></div>
        <p class=\"qual\">Other barriers were not recorded; homeowners served overall is unknown.</p>
        <p><b>Turnaround:</b> median 8 days for 11 cases; 4 had no time recorded.</p>
        <p class=\"qual\">“Around two weeks last spring” is an unmethoded note with no case IDs or sample size, so it is not a comparable baseline.</p>
      </section>
    </div>
    <section class=\"answerability\" aria-labelledby=\"need-title\">
      <div><h2 id=\"need-title\">What would answer both questions?</h2><p>Use a shared period and consistent reporting rules across partners.</p></div>
      <div class=\"needs\"><span class=\"need\">Homeowners served denominator</span><span class=\"need\">Same barrier definitions + overlap rule</span><span class=\"need\">All barriers recorded</span><span class=\"need\">Comparable turnaround baseline + current measure</span><span class=\"need\">Coverage and missing-time counts</span></div>
    </section>
    <footer><span>Current evidence does not support an overall ranking or improvement claim.</span><span>Counts shown within each source only</span></footer>
  </article>
</div>
<script>
'''+js+'''
</script>
</body>
</html>
