from pathlib import Path
css=Path('inputs/lys/lys.css').read_text()
js=Path('inputs/lys/lys.iife.js').read_text()
html='''<"'!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Two places for the repair workshop</title>
<style>
'"'''+css+'''
</style>
<style>
:root { --lys-backdrop: #f2f5f3; --lys-font-size-base: clamp(14px, 1.6cqi, 22px); --lys-slide-padding: clamp(22px, 4.2cqi, 64px); --lys-aspect-ratio: 16 / 9; }
* { box-sizing: border-box; }
body { margin:0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif; }
[data-lys] { color:#152d2a; background:#f2f5f3; }
[data-lys] > article { background:#f2f5f3; }
.slide { display:flex; flex-direction:column; gap:clamp(16px,2.4cqi,30px); }
.kicker { margin:0; color:#397267; font-size:.78em; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
h1 { margin:0; font-size:2.05em; line-height:1.08; letter-spacing:-.035em; font-weight:750; }
.venues { display:grid; grid-template-columns:1fr 1fr; gap:clamp(14px,2cqi,28px); flex:1; min-height:0; }
.venue { border:1px solid #c8d8d2; border-radius:18px; padding:clamp(18px,2.4cqi,34px); background:#fff; box-shadow:0 10px 28px #183c3310; }
.venue h2 { margin:0 0 .7em; padding-bottom:.45em; border-bottom:3px solid #78a99c; color:#164a40; font-size:1.35em; line-height:1.15; }
dl { display:grid; grid-template-columns:minmax(5.5em, .58fr) 1fr; gap:.8em .75em; margin:0; line-height:1.28; }
dt { color:#536d67; font-weight:700; }
dd { margin:0; font-weight:520; }
.caveat { margin:0; padding:12px 16px; border-left:4px solid #c78638; background:#f8ecd9; border-radius:0 8px 8px 0; font-size:.84em; line-height:1.35; }
@media (max-width:600px) {
 :root { --lys-aspect-ratio: 390 / 844; --lys-slide-padding: 22px; --lys-font-size-base: 15px; }
 [data-lys] { height:100svh; }
 [data-lys] > article { width:100vw; height:100svh; max-height:100svh; aspect-ratio:auto; }
 .slide { gap:15px; }
 h1 { font-size:1.9em; }
 .venues { grid-template-columns:1fr; gap:12px; }
 .venue { padding:15px 17px; border-radius:14px; }
 .venue h2 { margin-bottom:.55em; font-size:1.2em; }
 dl { grid-template-columns:5.6em 1fr; gap:.48em .7em; }
 .caveat { font-size:.78em; padding:10px 12px; }
}
@media print {
 :root { --lys-print-page-size: 13.333in 7.5in; --lys-aspect-ratio:16 / 9; }
 [data-lys] > article { width:100%; height:auto; aspect-ratio:16 / 9; }
 .slide { gap:24px; }
}
</style>
</head>
<body>
<div data-lys>
  <article class=\"slide\" aria-label=\"Two places for the repair workshop\" data-notes=\"Both venues receive equal consideration. All costs are provisional quotes for one evening; staffing and insurance are excluded.\">
    <p class=\"kicker\">What trade-offs do the two venues offer?</p>
    <h1>Two places for the repair workshop</h1>
    <div class=\"venues\">
      <section class=\"venue\" aria-labelledby=\"station-title\">
        <h2 id=\"station-title\">Station hall</h2>
        <dl>
          <dt>Capacity</dt><dd>48 people</dd>
          <dt>Hire</dt><dd>€240 per evening</dd>
          <dt>Access</dt><dd>Step-free entrance, next to the bus station</dd>
          <dt>Constraint</dt><dd>Tools and tables must be removed each evening</dd>
        </dl>
      </section>
      <section class=\"venue\" aria-labelledby=\"garden-title\">
        <h2 id=\"garden-title\">Garden room</h2>
        <dl>
          <dt>Capacity</dt><dd>32 people</dd>
          <dt>Hire</dt><dd>€160 per evening</dd>
          <dt>Access</dt><dd>Step-free entrance, 700 m from the bus station</dd>
          <dt>Constraint</dt><dd>Tools can stay in a locked cupboard</dd>
        </dl>
      </section>
    </div>
    <p class=\"caveat\">All costs are provisional quotes for one evening; staffing and insurance are excluded.</p>
  </article>
</div>
<script>
'''+js+'''
</script>
</body>
</html>
'''
Path('output/slide.html').write_text(html)
