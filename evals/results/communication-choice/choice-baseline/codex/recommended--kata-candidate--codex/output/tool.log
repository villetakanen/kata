from pathlib import Path
css=Path('inputs/lys/lys.css').read_text()
js=Path('inputs/lys/lys.iife.js').read_text()
html='''<"'!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Two places for the repair workshop</title>
<style>
'"'''+css+'''
</style>
<style>
:root{--lys-backdrop:#f3f1eb;--lys-aspect-ratio:16 / 9;--lys-slide-padding:clamp(22px,4.2cqi,62px);--lys-font-size-base:16px;--lys-focus-ring:3px solid #c74d2c}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#182a33;background:#f3f1eb}
[data-lys]{background:#f3f1eb;color:#182a33}
[data-lys]>article{background:#f3f1eb;color:#182a33}
.slide{display:flex;flex-direction:column;gap:clamp(12px,2cqi,24px)}
.eyebrow{margin:0;color:#4d6870;font-size:.76rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
h1{font-size:clamp(30px,4.4cqi,58px);line-height:1.03;letter-spacing:-.045em;margin:0;max-width:18ch}
.deck{display:grid;grid-template-columns:1fr 1fr;gap:clamp(12px,2cqi,24px);min-height:0;flex:1}
.option{border:1px solid #bac5c1;border-radius:16px;padding:clamp(16px,2cqi,28px);background:#fff;display:flex;flex-direction:column;gap:clamp(10px,1.5cqi,18px)}
.option.recommended{border:2px solid #c74d2c;background:#fffaf6}
.option h2{font-size:clamp(22px,2.5cqi,32px);line-height:1.05;letter-spacing:-.025em;margin:0}
.badge{display:inline-block;color:#8f361f;background:#f7e1d6;border-radius:99px;padding:5px 10px;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;font-weight:800;align-self:flex-start}
dl{margin:0;display:grid;grid-template-columns:minmax(82px,.62fr) 1.4fr;gap:10px 14px;font-size:clamp(14px,1.3cqi,18px);line-height:1.28}
dt{color:#4d6870;font-weight:750}dd{margin:0;font-weight:560}
.rationale{margin:0;padding:14px 16px;border-left:5px solid #c74d2c;background:#f7e1d6;border-radius:0 10px 10px 0;font-weight:750;font-size:clamp(15px,1.45cqi,20px);line-height:1.3}
.caveat{margin:0;color:#40555d;font-size:clamp(12px,1.05cqi,15px);line-height:1.3}
@media(max-width:600px){
 :root{--lys-slide-padding:24px;--lys-aspect-ratio:auto}
 [data-lys]{height:100dvh;display:block;overflow:auto;scroll-snap-type:y proximity}
 [data-lys]>article{width:100%;height:auto;min-height:100dvh;max-height:none;aspect-ratio:auto;overflow:visible;padding:24px}
 .slide{gap:16px}
 h1{font-size:36px;max-width:15ch}
 .deck{grid-template-columns:1fr;gap:12px;flex:initial}
 .option{padding:17px;gap:12px}
 .option h2{font-size:25px}
 dl{grid-template-columns:102px 1fr;font-size:15px;gap:9px 12px}
 .rationale{font-size:15px;padding:12px 14px}
 .caveat{font-size:13px;padding-bottom:4px}
}
@media print{
 :root{--lys-print-page-size:13.333in 7.5in}
 [data-lys]>article{width:100%;height:100vh;max-height:none;overflow:visible;aspect-ratio:16 / 9}
}
</style>
</head>
<body>
<div data-lys aria-label=\"Two places for the repair workshop\">
<article class=\"slide\" aria-labelledby=\"slide-title\" data-notes=\"The committee provisionally recommends Station hall for capacity and bus access. Garden room remains the alternative. Costs are provisional quotes for one evening; staffing and insurance are excluded. Booking is not approved.\">
<p class=\"eyebrow\">Repair workshop · venue comparison</p>
<h1 id=\"slide-title\">Two places for the repair workshop</h1>
<div class=\"deck\">
<section class=\"option recommended\" aria-labelledby=\"station-title\">
<span class=\"badge\">Provisional recommendation</span>
<h2 id=\"station-title\">Station hall</h2>
<dl>
<dt>Capacity</dt><dd>48 people</dd>
<dt>Hire</dt><dd>€240 per evening</dd>
<dt>Access</dt><dd>Step-free entrance, next to the bus station</dd>
<dt>Constraint</dt><dd>Tools and tables must be removed each evening</dd>
</dl>
</section>
<section class=\"option\" aria-labelledby=\"garden-title\">
<h2 id=\"garden-title\">Garden room</h2>
<dl>
<dt>Capacity</dt><dd>32 people</dd>
<dt>Hire</dt><dd>€160 per evening</dd>
<dt>Access</dt><dd>Step-free entrance, 700 m from the bus station</dd>
<dt>Constraint</dt><dd>Tools can stay in a locked cupboard</dd>
</dl>
</section>
</div>
<p class=\"rationale\">The committee provisionally recommends Station hall for its capacity and bus access; booking is not approved.</p>
<p class=\"caveat\">All costs are provisional quotes for one evening; staffing and insurance are excluded.</p>
</article>
</div>
<script>
'''+js+'''
</script>
</body>
</html>
'''
Path('output/slide.html').write_text(html)
