from pathlib import Path
import json
root = Path('.')
css = (root / 'inputs/lys/lys.css').read_text()
js = (root / 'inputs/lys/lys.iife.js').read_text()
custom = r'''
:root { color-scheme: light; }
[data-lys] {
  --lys-backdrop: #e9eee8;
  --lys-aspect-ratio: 16 / 9;
  --lys-slide-padding: 0;
  --lys-font-size-base: clamp(10px, 1.1cqi, 16px);
  --lys-slide-max-width: 100vw;
  --lys-slide-max-height: 100vh;
  --ink: #173a32;
  --muted: #536b62;
  --paper: #f8f7f0;
  --line: #d6dfd5;
  --green: #1c6651;
  --lime: #c8df77;
  --coral: #d36c50;
}
[data-lys] > article { background: var(--paper); color: var(--ink); }
.slide {
  box-sizing: border-box;
  width: 100%; height: 100%; padding: 5.3% 6.1%;
  display: grid; grid-template-rows: auto 1fr auto; gap: 3.2%;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;
  font-size: 1rem; line-height: 1.35;
}
.topline { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:.78rem; letter-spacing:.12em; text-transform:uppercase; font-weight:700; }
.kicker { display:flex; align-items:center; gap:.6rem; }
.kicker::before { content:\"\"; width:.65rem; height:.65rem; border-radius:50%; background:var(--coral); }
.issue { border:1px solid var(--line); border-radius:99px; padding:.35rem .75rem; letter-spacing:.06em; }
main { min-height:0; display:grid; grid-template-columns: 1.08fr .92fr; gap:5%; align-items:stretch; }
.left { display:flex; flex-direction:column; justify-content:center; }
h1 { font-size:2.65rem; line-height:1.03; letter-spacing:-.045em; margin:0 0 1.3rem; max-width:13ch; }
.verdict { border-left:4px solid var(--coral); padding:.35rem 0 .35rem 1rem; color:var(--muted); font-size:1.05rem; max-width:49ch; }
.verdict strong { color:var(--ink); }
.chartbox { margin-top:2.2rem; background:#edf1e9; border-radius:1rem; padding:1rem 1.15rem 1.1rem; }
.chart-title { font-weight:750; font-size:.85rem; color:var(--ink); margin-bottom:.8rem; }
.range { position:relative; height:2.4rem; margin:0 .3rem .3rem; }
.track { position:absolute; top:1.02rem; left:5%; right:5%; height:3px; background:#9eb5a5; }
.rangebar { position:absolute; left:5%; width:85%; top:.8rem; height:.48rem; border-radius:99px; background:var(--green); }
.median { position:absolute; left:50%; top:.34rem; width:.16rem; height:1.4rem; background:var(--coral); border-radius:4px; }
.median-label { position:absolute; left:50%; top:-.15rem; transform:translate(-50%,-100%); background:var(--coral); color:white; font-size:.7rem; line-height:1; font-weight:750; padding:.36rem .55rem; border-radius:99px; white-space:nowrap; }
.axis { display:flex; justify-content:space-between; color:var(--muted); font-size:.7rem; margin:0 .05rem; }
.chart-foot { display:flex; justify-content:space-between; gap:1rem; margin-top:.85rem; padding-top:.75rem; border-top:1px solid var(--line); font-size:.8rem; }
.chart-foot strong { font-size:1.05rem; color:var(--green); }
.chart-foot span { color:var(--muted); }
.right { display:flex; flex-direction:column; justify-content:center; gap:.85rem; }
.card { background:white; border:1px solid var(--line); border-radius:1rem; padding:1rem 1.1rem; }
.card h2 { margin:0 0 .5rem; font-size:.92rem; letter-spacing:.02em; }
.card p { margin:0; color:var(--muted); font-size:.82rem; }
.limits { border-top:3px solid var(--coral); }
.limits ul { margin:.4rem 0 0; padding-left:1.05rem; color:var(--muted); font-size:.78rem; }
.limits li + li { margin-top:.24rem; }
.action { background:var(--ink); color:white; border:0; padding:1.05rem 1.1rem; }
.action h2 { color:var(--lime); }
.action p { color:#e3ebe4; }
.action strong { color:white; }
.foot { display:flex; justify-content:space-between; align-items:center; gap:1rem; color:var(--muted); font-size:.68rem; padding-top:.6rem; border-top:1px solid var(--line); }
.foot .source { max-width:78%; }
@media (max-width:700px) {
 .slide { padding:5%; gap:2%; }
 main { grid-template-columns:1fr 1fr; gap:3%; }
 h1 { font-size:2.15rem; }
 .right { gap:.55rem; }
 .card { padding:.7rem; }
}
@media print { [data-lys] > article { background:var(--paper) "'!important; } }
