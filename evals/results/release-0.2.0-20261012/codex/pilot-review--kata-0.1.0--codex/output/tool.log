/bin/zsh -lc "mkdir -p output && python3 - <<'PY'
from pathlib import Path
css = Path('inputs/lys/lys.css').read_text()
js = Path('inputs/lys/lys.iife.js').read_text()
html = '''<"'!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Riverbank lighting pilot — steering decision</title>
<style>
'"''' + css + '''
:root {
  --lys-backdrop: #101d2b;
  --lys-slide-padding: 5.2cqi;
  --lys-font-size-base: clamp(12px, 1.28cqi, 18px);
  --lys-transition-duration: 0s;
  color-scheme: light;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;
}
[data-lys] { background: #101d2b; color: #f4f0e7; }
[data-lys] > article {
  background: #101d2b;
  color: #f4f0e7;
  display: flex;
  flex-direction: column;
  gap: 2.4cqi;
}
.slide-head { display:flex; align-items:center; justify-content:space-between; gap:2cqi; }
.kicker { color:#8fd5c0; font-size:.78em; font-weight:750; letter-spacing:.14em; text-transform:uppercase; }
.scope { color:#c2cbd0; font-size:.76em; text-align:right; }
h1 { font-size:2.35em; line-height:1.05; letter-spacing:-.04em; max-width:25em; margin:0; }
.content { display:grid; grid-template-columns: 1.08fr .92fr; gap:2.3cqi; min-height:0; flex:1; }
.evidence, .decision { border-radius:1.25cqi; padding:2.15cqi; }
.evidence { background:#1b2d3e; border:1px solid #34495a; }
.decision { background:#f4f0e7; color:#142538; display:flex; flex-direction:column; justify-content:space-between; }
.label { color:#9db0bd; font-size:.78em; font-weight:750; letter-spacing:.12em; text-transform:uppercase; margin:0 0 1.15cqi; }
.decision .label { color:#426b63; }
.stat { display:flex; align-items:baseline; gap:.7cqi; margin:.2cqi 0 .6cqi; }
.stat strong { color:#a5e0cc; font-size:5.1em; line-height:.95; letter-spacing:-.07em; }
.stat span { font-size:1.1em; font-weight:650; }
.subline { color:#d3dce0; font-size:1em; margin:0 0 1.4cqi; }
.plot-row { display:grid; grid-template-columns:repeat(18,1fr); gap:.55cqi; margin:.55cqi 0 1.1cqi; }
.plot { aspect-ratio:1; border-radius:.28cqi; background:#e4a768; border:1px solid rgba(255,255,255,.24); }
.plot.positive { background:#61bea4; }
.legend { display:flex; gap:1.7cqi; flex-wrap:wrap; color:#d3dce0; font-size:.78em; }
.legend b { display:inline-flex; align-items:center; gap:.5cqi; font-weight:550; }
.key { width:.75em; height:.75em; border-radius:.15em; display:inline-block; }
.range { display:flex; justify-content:space-between; gap:1cqi; padding-top:1.1cqi; margin-top:1.1cqi; border-top:1px solid #405365; color:#d3dce0; font-size:.88em; }
.range strong { color:#fff; }
.pilot-scope { color:#aebdc6; font-size:.76em; margin-top:1.25cqi; }
.action { font-size:2.1em; line-height:1.08; letter-spacing:-.035em; font-weight:760; margin:0 0 1.3cqi; }
.action strong { color:#277d68; }
.action-detail { color:#30495b; font-size:.98em; line-height:1.45; margin:0; }
.boundary { border-top:1px solid #c9d0ca; margin-top:1.6cqi; padding-top:1.2cqi; font-size:.78em; line-height:1.4; color:#38505e; }
.boundary strong { color:#142538; }
.footer { color:#aebdc6; font-size:.73em; display:flex; justify-content:space-between; gap:2cqi; }
@media (max-width: 700px) {
  [data-lys] > article { --lys-slide-padding: 6cqi; }
  .content { grid-template-columns:1fr; grid-template-rows:auto auto; gap:2cqi; }
  .evidence,.decision { padding:2.4cqi; }
  .stat strong { font-size:4em; }
  h1 { font-size:2em; }
}
@media print { [data-lys] { background:#101d2b; } }
</style>
</head>
<body>
<div data-lys>
  <article id=\"decision\" aria-labelledby=\"slide-title\" data-notes=\"The pilot covered 18 greenhouse plots at three sites during one winter growing cycle. Median yield difference was +6% versus each site's reference plots; individual plot differences ranged from −3% to +14%. Twelve of 18 plots were positive and six were not. Plots were not randomly assigned, and crop mix and baseline conditions differed between sites, so the observed difference cannot be attributed to lighting. Installation cost and energy use were not measured. Recommendation: authorize another measurement cycle; include cost and energy alongside yield before considering wider installation. The steering group has not approved wider installation.\">
    <div class=\"slide-head\">
      <div class=\"kicker\">Riverbank · steering decision</div>
      <div class=\"scope\">Supplemental lighting pilot · 3 sites · 1 winter cycle</div>
    </div>
    <h1 id=\"slide-title\">Authorize another measurement cycle before considering wider installation.</h1>
    <div class=\"content\">
      <section class=\"evidence\" aria-label=\"Pilot evidence\">
        <p class=\"label\">What the pilot observed</p>
        <div class=\"stat\"><strong>+6%</strong><span>median yield difference</span></div>
        <p class=\"subline\">Versus each site's reference plots</p>
        <div class=\"plot-row\" role=\"img\" aria-label=\"18 plots: 12 had a positive yield difference and 6 did not\">
          ''' + ''.join('<span class=\"plot positive\"></span>' if i < 12 else '<span class=\"plot\"></span>' for i in range(18)) + '''
        </div>
        <div class=\"legend\">
          <b><i class=\"key\" style=\"background:#61bea4\"></i>12 of 18 positive</b>
          <b><i class=\"key\" style=\"background:#e4a768\"></i>6 of 18 not positive</b>
        </div>
        <div class=\"range\"><span>Individual plot differences</span><strong>−3% to +14%</strong></div>
        <div class=\"pilot-scope\">18 plots · 3 sites · one winter growing cycle</div>
      </section>
      <section class=\"decision\" aria-label=\"Decision and evidence limits\">
        <div>
          <p class=\"label\">What the evidence supports next</p>
          <p class=\"action\"><strong>Run another measurement cycle.</strong></p>
          <p class=\"action-detail\">Track yield alongside installation cost and energy use to inform any later decision on wider installation.</p>
        </div>
        <div class=\"boundary\"><strong>Interpret with care:</strong> plots were not randomly assigned; crop mix and baseline conditions differed between sites. The observed yield difference does not establish that lighting caused it.</div>
      </section>
    </div>
    <div class=\"footer\"><span>Cost and energy use were not measured in this pilot.</span><span>Wider installation has not been approved.</span></div>
  </article>
</div>
<script>
''' + js + '''
</script>
</body>
</html>
'''
Path('output/slide.html').write_text(html)
PY
cat > output/decision.json <<'EOF'
{
  \"protocol\": \"kata-eval-decision/v1\",
  \"audience_question\": \"What does the pilot evidence support the steering group doing next?\",
  \"form\": \"Evidence-to-decision pathway\",
  \"fit_rationale\": \"The slide pairs the pilot's observed yield signal and plot-to-plot spread with the bounded next action, while keeping the non-randomized design and missing cost and energy measures visible. This directly answers what the steering group can support now without implying causation or wider rollout.\",
  \"tradeoff\": \"A compact evidence-to-action layout prioritizes the steering decision over site-by-site detail; the three-site scope and one-cycle duration remain explicit, but site-level results are not available in the brief.\",
  \"caveats\": [
    \"18 plots across three sites over one winter growing cycle; median yield difference was +6% versus each site's reference plots, with individual plot differences from −3% to +14%.\",
    \"12 of 18 plots had a positive difference and six did not.\",
    \"Plots were not randomly assigned, and crop mix and baseline conditions differed between sites; the pilot does not establish that lighting caused the observed differences.\",
    \"Installation cost and energy use were not measured, so yield alone does not support wider installation.\"
  ]
}
EOF
