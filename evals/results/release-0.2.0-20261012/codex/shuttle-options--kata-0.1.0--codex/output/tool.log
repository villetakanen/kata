from pathlib import Path
import json
root = Path('.')
css = (root / 'inputs/lys/lys.css').read_text()
js = (root / 'inputs/lys/lys.iife.js').read_text()
out = root / 'output'
out.mkdir(exist_ok=True)
html = '''<"'!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Campus shuttle range and cost comparison</title>
  <style>
'"'''+css+'''
  </style>
  <style>
    :root {
      color-scheme: light;
      --lys-backdrop: #e8edf1;
      --lys-slide-padding: 5.2%;
      --lys-font-size-base: clamp(14px, 1.45cqi, 21px);
      --lys-focus-ring: 3px solid #d9653b;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: #e8edf1; color: #102b3b; }
    [data-lys] { color: #102b3b; background: #e8edf1; }
    [data-lys] > article {
      --lys-slide-padding: 5.2%;
      --lys-aspect-ratio: 16 / 9;
      background: #f8f7f2;
      color: #102b3b;
      display: flex;
      flex-direction: column;
      gap: 2.1cqh;
    }
    .kicker { margin: 0; color: #b34c2e; font-size: .68em; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    h1 { max-width: 21em; margin: .25em 0 0; font-size: 2.05em; line-height: 1.08; letter-spacing: -.035em; }
    .subhead { margin: .45em 0 0; color: #526875; font-size: .91em; }
    .decision { color: #9f3d25; font-weight: 750; }
    .table-wrap { margin-top: 1.05cqh; border: 1px solid #cbd5d9; border-radius: 12px; overflow: hidden; background: #fff; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: .88em; }
    caption { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    th, td { padding: .72em .85em; text-align: center; border-bottom: 1px solid #e1e7e8; font-variant-numeric: tabular-nums; }
    thead th { background: #102b3b; color: #fff; font-size: .82em; font-weight: 700; }
    thead th:first-child { width: 25%; text-align: left; }
    tbody th { text-align: left; color: #294655; font-weight: 700; background: #f2f5f4; }
    tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
    td { color: #193747; font-weight: 650; }
    .winner-col { background: #fff4ed; }
    thead .winner-col { background: #963e27; }
    .winner-name { display: block; }
    .winner-mark { display: inline-block; margin-top: .3em; padding: .18em .48em; border-radius: 99px; background: #f5d4c5; color: #7f321f; font-size: .64em; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
    .status { display: block; margin-top: .22em; color: #60737b; font-size: .69em; font-weight: 650; }
    .meets { color: #16705f; }
    .below { color: #775d45; }
    .unit { display: block; margin-top: .15em; color: #b9c9cf; font-size: .8em; font-weight: 500; }
    .criteria { margin: auto 0 0; padding: .72em .9em; border-left: 4px solid #d9653b; background: #f1eee5; color: #364f5c; font-size: .76em; line-height: 1.35; }
    .criteria strong { color: #102b3b; }
    .source-note { margin: 0; color: #667881; font-size: .64em; line-height: 1.35; }
    @media (max-width: 700px) {
      [data-lys] > article { --lys-slide-padding: 4%; gap: 1.5cqh; }
      h1 { font-size: 1.65em; }
      table { font-size: .72em; }
      th, td { padding: .58em .35em; }
      thead th:first-child { width: 27%; }
      .criteria { font-size: .68em; }
      .source-note { font-size: .58em; }
    }
    @media print { body, [data-lys] { background: white; } }
  </style>
</head>
<body>
  <div data-lys>
    <article aria-labelledby=\"slide-title\" data-notes=\"Alder is the lowest upfront-cost option among vehicles meeting the procurement minimum: 210 km range at USD 38k. Birch and Dogwood also meet the 200 km minimum; Cedar is below it at 190 km. Upfront and annual energy costs are estimates in USD thousands from the same procurement worksheet. Annual energy estimates assume 18,000 km of service per vehicle and exclude maintenance and charging-infrastructure costs. No uncertainty ranges were provided.\">
      <header>
        <p class=\"kicker\">Campus shuttle procurement · decision comparison</p>
        <h1 id=\"slide-title\">Alder clears the 200 km minimum at the lowest upfront cost</h1>
        <p class=\"subhead\">Among the qualifying options, <span class=\"decision\">Alder costs USD 38k upfront</span>.</p>
      </header>
      <div class=\"table-wrap\">
        <table>
          <caption>Range, upfront cost, and estimated annual energy cost for all campus shuttle options.</caption>
          <thead>
            <tr>
              <th scope=\"col\">Same criteria for every option</th>
              <th scope=\"col\" class=\"winner-col\"><span class=\"winner-name\">Alder</span><span class=\"winner-mark\">Lowest upfront · qualifies</span></th>
              <th scope=\"col\"><span class=\"winner-name\">Birch</span></th>
              <th scope=\"col\"><span class=\"winner-name\">Cedar</span></th>
              <th scope=\"col\"><span class=\"winner-name\">Dogwood</span></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope=\"row\">Range <span class=\"unit\">kilometres</span></th>
              <td class=\"winner-col\">210<span class=\"status meets\">Meets · 200 km min.</span></td>
              <td>240<span class=\"status meets\">Meets · 200 km min.</span></td>
              <td>190<span class=\"status below\">Below · 200 km min.</span></td>
              <td>220<span class=\"status meets\">Meets · 200 km min.</span></td>
            </tr>
            <tr>
              <th scope=\"row\">Upfront cost <span class=\"unit\">USD thousands</span></th>
              <td class=\"winner-col\">38</td><td>44</td><td>35</td><td>47</td>
            </tr>
            <tr>
              <th scope=\"row\">Estimated annual energy cost <span class=\"unit\">USD thousands</span></th>
              <td class=\"winner-col\">4.2</td><td>3.9</td><td>4.5</td><td>3.8</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class=\"criteria\"><strong>Decision rule:</strong> first meet the minimum range of 200 km, then compare upfront cost. Alder is the lowest upfront-cost qualifying option; this does not make it lowest on annual energy cost.</p>
      <p class=\"source-note\">Energy estimates assume 18,000 km of service per vehicle; maintenance and charging-infrastructure costs are excluded. All figures are estimates from the same procurement worksheet; no uncertainty ranges were provided.</p>
    </article>
  </div>
  <script>
'''+js+'''
  </script>
</body>
</html>
'''
(out / 'slide.html').write_text(html)
data = {
  \"protocol\": \"kata-eval-decision/v1\",
  \"audience_question\": \"Which shuttle option meets the minimum range at the lowest upfront cost?\",
  \"form\": \"aligned comparison matrix\",
  \"fit_rationale\": \"A matrix keeps all four options aligned on the same three criteria, shows the 200 km gate beside each range, and preserves exact values and units so the qualifying options' upfront costs can be compared directly.\",
  \"tradeoff\": \"The matrix favors exact side-by-side values over a proportional visual scale, so readers compare range magnitudes from the printed numbers.\",
  \"caveats\": [
    \"The procurement minimum is 200 km; Cedar's 190 km range does not qualify.\",
    \"Annual energy-cost estimates assume 18,000 km of service per vehicle and exclude maintenance and charging-infrastructure costs.\",
    \"All figures are estimates from the same procurement worksheet; no uncertainty ranges were provided.\",
    \"Alder is the lowest upfront-cost qualifying option, not the lowest annual energy-cost option.\"
  ]
}
(out / 'decision.json').write_text(json.dumps(data, indent=2) + '\\n')
