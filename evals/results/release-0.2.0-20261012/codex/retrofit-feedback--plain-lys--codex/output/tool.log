from pathlib import Path
import json
root = Path('.')
css = (root / 'inputs/lys/lys.css').read_text()
js = (root / 'inputs/lys/lys.iife.js').read_text()
custom = r''' 
:root { color-scheme: light; }
* { box-sizing: border-box; }
body { margin: 0; background: #0b1422; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }
[data-lys] { --lys-backdrop: #0b1422; --lys-aspect-ratio: 16 / 9; --lys-slide-padding: 0; --lys-font-size-base: clamp(14px, 1.12cqi, 19px); color: #f5f7fb; background: #0b1422; }
[data-lys] > article { padding: 4.2% 5.1%; background: #0b1422; }
.slide { height: 100%; display: flex; flex-direction: column; gap: 2.1%; }
.eyebrow { display: flex; align-items: center; gap: .55em; color: #7bdacb; font-size: .72em; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
.eyebrow::before { content: \"\"; width: 1.4em; height: 2px; background: #53cbb8; }
h1 { margin: .18em 0 .32em; max-width: 27em; color: #fff; font-size: 2.16em; line-height: 1.06; letter-spacing: -.045em; }
.answer { padding: .73em 1em; border-left: 4px solid #f4b958; border-radius: 0 8px 8px 0; background: #172438; color: #e7edf7; font-size: 1.02em; line-height: 1.35; }
.answer strong { color: #ffd27c; }
.grid { display: grid; grid-template-columns: 1.05fr 1.05fr .9fr; gap: 1.15em; min-height: 0; flex: 1; }
.panel { min-width: 0; padding: 1.05em 1.15em; border: 1px solid #34455c; border-radius: 12px; background: #111e30; }
.panel h2 { margin: 0 0 .72em; color: #c7d3e2; font-size: .76em; letter-spacing: .11em; text-transform: uppercase; }
.big { margin: -.08em 0 .32em; color: #fff; font-size: 2.02em; font-weight: 750; line-height: 1; letter-spacing: -.05em; }
.big span { color: #7bdacb; }
.sub { margin: 0 0 .8em; color: #aebdd0; font-size: .76em; line-height: 1.35; }
.rows { display: grid; gap: .45em; }
.row { display: flex; justify-content: space-between; gap: .8em; align-items: baseline; padding-top: .42em; border-top: 1px solid #27384d; color: #e5ebf3; font-size: .82em; line-height: 1.25; }
.row b { white-space: nowrap; color: #fff; }
.note { margin-top: .7em; color: #95a6bc; font-size: .67em; line-height: 1.35; }
.turn .big { color: #ffd27c; font-size: 1.82em; }
.turn .big span { color: #fff; }
.callout { margin-top: .9em; padding: .7em .75em; border-radius: 8px; background: #2a2630; color: #e7d7bd; font-size: .74em; line-height: 1.4; }
.footer { display: grid; grid-template-columns: .78fr 1.22fr; gap: 1.5em; align-items: center; padding-top: .65em; border-top: 1px solid #34455c; }
.footer h2 { margin: 0 0 .26em; color: #7bdacb; font-size: .69em; letter-spacing: .12em; text-transform: uppercase; }
.footer p { margin: 0; color: #d1dbe8; font-size: .76em; line-height: 1.35; }
.footer strong { color: #fff; }
@media (max-width: 760px) {
 [data-lys] { height: auto; min-height: 100vh; overflow: visible; display: block; }
 [data-lys] > article { width: 100%; max-height: none; aspect-ratio: auto; min-height: 100vh; padding: 28px 22px; }
 .slide { gap: 16px; }
 h1 { font-size: clamp(30px, 8vw, 48px); }
 .grid { grid-template-columns: 1fr; gap: 12px; }
 .panel { padding: 18px; }
 .footer { grid-template-columns: 1fr; gap: 12px; }
}
@media print { body { background: #0b1422; } }
'''
html = f'''<"'!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Retrofit feedback: what we can conclude</title>
<style>
{css}
{custom}
</style>
</head>
<body>
<div data-lys aria-label="Home retrofit feedback summary">
  <article aria-labelledby="slide-title" data-notes="The overall barrier ranking cannot be established because the partners used separate summaries with incompatible denominators and barrier recording. North surveyed 40 homeowners with multiple selections allowed. South reviewed 15 open cases, but the number of homeowners served is unknown and other barriers were not consistently recorded. Do not pool the counts. Turnaround improvement cannot be inferred: the recent median covers 11 cases, while the prior-season note has no identified cases, sample size, or method. A comparable baseline and consistent collection are needed.">
    <main class="slide">
      <header>
        <div class="eyebrow">Home retrofit feedback · Program leads</div>
        <h1 id="slide-title">Which barrier is most common overall—and did turnaround improve?</h1>
        <div class="answer"><strong>Neither can be answered from these summaries.</strong> Both point to installer delays, but there is no compatible overall comparison or comparable turnaround baseline.</div>
      </header>
      <section class="grid" aria-label="Evidence by source and turnaround">
        <section class="panel" aria-labelledby="north-title">
          <h2 id="north-title">Partner North · homeowner survey</h2>
          <p class="big"><span>28</span> of 40</p>
          <p class="sub">selected installer scheduling; respondents could select multiple barriers</p>
          <div class="rows">
            <div class="row"><span>Upfront cost</span><b>17 of 40</b></div>
            <div class="row"><span>Unclear eligibility</span><b>9 of 40</b></div>
          </div>
          <p class="note">Selections overlap. These counts describe North’s survey only.</p>
        </section>
        <section class="panel" aria-labelledby="south-title">
          <h2 id="south-title">Partner South · open case review</h2>
          <p class="big"><span>9</span> of 15 cases</p>
          <p class="sub">mentioned “waiting for an installer”</p>
          <div class="rows">
            <div class="row"><span>Homeowners served</span><b>not reported</b></div>
            <div class="row"><span>Other barriers</span><b>not recorded</b></div>
          </div>
          <p class="note">Cases are not a reported homeowner denominator; do not compare or pool with North.</p>
        </section>
        <section class="panel turn" aria-labelledby="turn-title">
          <h2 id="turn-title">Service turnaround</h2>
          <p class="big"><span>8 days</span> median</p>
          <p class="sub">for 11 of 15 South cases; 4 had no time recorded</p>
          <div class="callout">“Around two weeks last spring” has no identified cases, sample size, or method. It is not a comparable baseline, so improvement is unknown.</div>
        </section>
      </section>
      <footer class="footer">
        <div><h2>To identify the leading barrier</h2><p>Use a shared period and barrier question, consistent coding, and a common denominator; define how multiple selections are counted.</p></div>
        <div><h2>To assess improvement</h2><p>Collect recent and baseline turnaround with the <strong>same method, period definition, and case scope</strong>, plus the number of cases and missing-time counts.</p></div>
      </footer>
    </main>
  </article>
</div>
<script>
{js}
</script>
</body>
</html>
'"'''
(root / 'output/slide.html').write_text(html)
decision = {
  \"protocol\": \"kata-eval-decision/v1\",
  \"audience_question\": \"Which retrofit barrier is most common overall, and did service turnaround improve?\",
  \"form\": \"evidence-led comparison slide with a conclusion banner, separate partner evidence panels, turnaround panel, and data-needed footer\",
  \"fit_rationale\": \"Separate panels preserve each partner's denominator and recording method, while the banner and turnaround panel make the two limits on inference explicit. A short footer specifies what comparable data would resolve each part of the question.\",
  \"tradeoff\": \"The slide gives less space to each partner's methodology so it can show both source-specific evidence and the turnaround caveat on one slide.\",
  \"caveats\": [
    \"North's 40 respondents could select multiple barriers, so counts overlap.\",
    \"South reviewed 15 open cases, not a reported count of homeowners served; other barriers were not recorded.\",
    \"No shared period definition or compatible denominator supports an overall barrier ranking across partners.\",
    \"South's 8-day median covers 11 cases; four case times are missing, and the prior 'around two weeks last spring' note has no identified cases, sample size, or method, so change cannot be inferred.\"
  ]
}
(root / 'output/decision.json').write_text(json.dumps(decision, ensure_ascii=False, indent=2) + '\\n')
