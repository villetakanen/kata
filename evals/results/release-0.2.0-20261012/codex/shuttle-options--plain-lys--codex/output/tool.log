th:first-child, td:first-child { text-align:left; }
tbody tr:last-child td { border-bottom:0; }
tbody tr.selected { background:#edf8f4; font-weight:700; }
tbody tr.selected td:first-child { color:var(--teal); }
.status { display:inline-block; padding:.22em .52em; border-radius:99px; background:#e6f4ef; color:#075c50; font-size:.72em; font-weight:750; }
.status.no { background:#f1ece4; color:var(--amber); }
.key { margin:.6em 0 0; color:var(--muted); font-size:.76em; }
.footer { margin-top:auto; padding-top:.75em; display:flex; justify-content:space-between; gap:2em; border-top:1px solid var(--line); color:var(--muted); font-size:.7em; line-height:1.4; }
.footer p { margin:0; }
.footer .source { text-align:right; max-width:26ch; }
@media (max-width:700px) { [data-lys] { --lys-slide-padding:4cqi; --lys-font-size-base:clamp(12px,2.5cqi,18px); } th,td { padding:.58em .42em; } .footer { gap:1em; } }
