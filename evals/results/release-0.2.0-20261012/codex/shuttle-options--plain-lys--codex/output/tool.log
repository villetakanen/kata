'"''' + css + '''
:root { color-scheme: light; --ink:#142c35; --muted:#526970; --teal:#006d69; --mint:#dff3ed; --paper:#f5f7f4; --line:#d6e1dc; --amber:#8a5520; }
* { box-sizing:border-box; }
body { margin:0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; background:var(--paper); color:var(--ink); }
[data-lys] { --lys-backdrop:var(--paper); --lys-aspect-ratio:16 / 9; --lys-slide-padding:5.3cqi; --lys-font-size-base:clamp(14px,1.35cqi,21px); }
article { background:var(--paper); }
.slide { height:100%; display:flex; flex-direction:column; }
.eyebrow { margin:0 0 .65em; color:var(--teal); font-weight:750; font-size:.72em; letter-spacing:.12em; text-transform:uppercase; }
h1 { margin:0; max-width:24ch; font-size:2.05em; line-height:1.08; letter-spacing:-.04em; }
.answer { margin:.75em 0 1.35em; padding:.78em 1em; display:flex; align-items:center; gap:.85em; background:var(--mint); border-left:5px solid var(--teal); border-radius:0 .55em .55em 0; font-size:1em; line-height:1.35; }
.answer strong { color:var(--teal); font-size:1.08em; }
.answer .check { flex:none; width:1.65em; height:1.65em; display:grid; place-items:center; border-radius:50%; background:var(--teal); color:white; font-weight:800; }
table { width:100%; border-collapse:collapse; font-size:.9em; background:#fff; border:1px solid var(--line); border-radius:.55em; overflow:hidden; }
caption { text-align:left; padding:0 0 .55em; color:var(--muted); font-size:.82em; }
th, td { padding:.72em .82em; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; }
