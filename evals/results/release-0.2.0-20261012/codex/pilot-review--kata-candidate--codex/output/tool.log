from pathlib import Path
root = Path('inputs')
css = (root / 'lys/lys.css').read_text()
js = (root / 'lys/lys.iife.js').read_text()
html = '''<"'!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Riverbank lighting pilot — next step</title>
  <style>
'"''' + css + '''
  </style>
  <style>
    :root {
      color-scheme: light;
      --lys-backdrop: #e8eee8;
      --lys-slide-padding: 5.2cqi;
      --lys-font-size-base: clamp(14px, 1.22cqi, 23px);
      --ink: #172d32;
      --muted: #52696b;
      --paper: #f8f8f2;
      --line: #d8e2dc;
      --green: #b8e35c;
      --deep: #173a3b;
      --teal: #2e7770;
      --coral: #bd5946;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }
    article.slide {
      background: var(--paper);
      color: var(--ink);
      display: flex;
      flex-direction: column;
      gap: 3.1cqi;
      padding: 4.5cqi 5.2cqi 4.1cqi;
    }
    .topline { display:flex; align-items:center; gap:.7em; color:var(--muted); font-size:.69em; font-weight:750; letter-spacing:.13em; text-transform:uppercase; }
    .topline::before { content:\"\"; width:1.8em; height:.22em; border-radius:99px; background:var(--teal); }
    h2 { max-width: 23ch; margin: .45em 0 0; font-size:2.18em; line-height:1.08; letter-spacing:-.045em; font-weight:760; }
    .accent { color:var(--teal); }
    .layout { min-height:0; flex:1; display:grid; grid-template-columns: .9fr 1.1fr; gap:2.2cqi; }
    .decision { background:var(--deep); color:#f7f8f1; border-radius:1.05em; padding:1.55em 1.65em; display:flex; flex-direction:column; justify-content:space-between; }
    .label { font-size:.68em; line-height:1.2; color:#a8c4ba; letter-spacing:.14em; font-weight:800; text-transform:uppercase; }
    .decision h3 { margin:.7em 0 .45em; font-size:1.65em; letter-spacing:-.035em; line-height:1.12; }
    .decision p { margin:0; font-size:.94em; line-height:1.4; color:#d6e3db; }
    .gate { margin-top:1.3em; border-top:1px solid #52706b; padding-top:1em; }
    .gate strong { display:block; color:var(--green); font-size:.76em; letter-spacing:.1em; text-transform:uppercase; margin-bottom:.45em; }
    .gate p { font-size:.85em; }
    .evidence { display:flex; flex-direction:column; gap:.8em; }
    .metric { background:#edf2ec; border:1px solid var(--line); border-radius:.9em; padding:1.1em 1.35em .95em; }
    .metric-head { display:flex; align-items:baseline; justify-content:space-between; gap:1em; }
    .metric h3 { margin:0; font-size:.78em; font-weight:760; color:var(--muted); letter-spacing:.05em; text-transform:uppercase; }
    .big { color:var(--teal); font-size:2em; font-weight:790; letter-spacing:-.055em; white-space:nowrap; }
    .metric p { margin:.25em 0 0; font-size:.77em; line-height:1.35; color:var(--muted); }
    .range { margin-top:.65em; }
    .range-caption { display:flex; justify-content:space-between; color:var(--muted); font-size:.66em; margin-bottom:.35em; }
    .track { height:.42em; position:relative; margin:0 .2em; background:#d8e1da; border-radius:99px; }
    .span { position:absolute; left:11.1%; width:94.4%; top:0; height:100%; background:#85aaa0; border-radius:99px; }
    .zero { position:absolute; left:27.8%; top:-.34em; height:1.1em; border-left:2px solid var(--ink); }
    .median { position:absolute; left:61.1%; top:50%; width:.85em; height:.85em; transform:translate(-50%,-50%); border:2px solid var(--paper); background:var(--teal); border-radius:50%; box-shadow:0 0 0 1px var(--teal); }
    .scale { display:flex; justify-content:space-between; margin-top:.35em; font-size:.62em; color:var(--muted); }
    .scale span:nth-child(2) { margin-left:-1.15em; }
    .count { background:#fff; border:1px solid var(--line); border-radius:.9em; padding:.85em 1.35em; display:flex; align-items:center; justify-content:space-between; gap:1em; }
    .count strong { color:var(--ink); font-size:1.16em; letter-spacing:-.025em; white-space:nowrap; }
    .count p { margin:0; color:var(--muted); font-size:.78em; line-height:1.35; text-align:right; }
    .limits { background:#f5eee5; border-left:.28em solid #d6a36e; border-radius:.25em .7em .7em .25em; padding:.85em 1.1em; }
    .limits h3 { margin:0 0 .35em; color:#875931; font-size:.66em; letter-spacing:.12em; text-transform:uppercase; }
    .limits p { margin:0; color:#5e5144; font-size:.74em; line-height:1.38; }
    .scope { color:var(--muted); font-size:.68em; font-weight:650; letter-spacing:.025em; }
    @media (max-aspect-ratio: 4/3) {
      article.slide { gap:2.3cqi; padding:4cqi; }
      h2 { font-size:1.8em; }
      .layout { gap:1.5cqi; grid-template-columns:.86fr 1.14fr; }
      .decision { padding:1.15em; }
    }
    @media print { :root { --lys-backdrop:#fff; } }
  </style>
</head>
<body>
  <div data-lys aria-label=\"Riverbank greenhouse lighting pilot\">
    <article class=\"slide\" aria-labelledby=\"slide-title\" data-notes=\"The pilot covered 18 greenhouse plots at three sites over one winter growing cycle. Its reported median yield difference versus each site's reference plots was +6%, with individual plot differences from −3% to +14%. Twelve plots were positive and six were not. Plots were not randomly assigned, and crop mix and baseline conditions differed between sites, so the pilot does not establish that lighting caused the differences. Installation cost and energy use were not measured.\">
      <header>
        <div class=\"topline\">Riverbank · Steering group decision</div>
        <h2 id=\"slide-title\">The pilot supports <span class=\"accent\">another measurement cycle</span>—not wider installation yet.</h2>
      </header>
      <div class=\"layout\">
        <section class=\"decision\" aria-labelledby=\"decision-title\">
          <div>
            <div class=\"label\">Recommended next step</div>
            <h3 id=\"decision-title\">Authorize one more measurement cycle.</h3>
            <p>The pilot shows a positive yield signal, with mixed plot results and important limits on interpretation.</p>
          </div>
          <div class=\"gate\">
            <strong>Before wider installation</strong>
            <p>Measure installation cost and energy use; neither was assessed in this pilot.</p>
          </div>
        </section>
        <section class=\"evidence\" aria-label=\"Pilot evidence and limitations\">
          <div class=\"metric\">
            <div class=\"metric-head\"><h3>Median yield difference</h3><div class=\"big\">+6%</div></div>
            <p>Versus each site's reference plots · individual plot differences ranged −3% to +14%</p>
            <div class=\"range\" role=\"img\" aria-label=\"Individual plot differences ranged from minus 3 percent to plus 14 percent. The reported median was plus 6 percent; zero marks no difference.\">
              <div class=\"range-caption\"><span>Individual plot range</span><span>Zero = no difference</span></div>
              <div class=\"track\"><div class=\"span\"></div><div class=\"zero\"></div><div class=\"median\"></div></div>
              <div class=\"scale\"><span>−5%</span><span>0%</span><span>+5%</span><span>+10%</span><span>+15%</span></div>
            </div>
          </div>
          <div class=\"count\"><strong>12 of 18 plots positive</strong><p>6 plots did not have a positive difference</p></div>
          <div class=\"limits\"><h3>Interpret with care</h3><p>Not randomly assigned; crop mix and baseline conditions differed by site. Observed differences do not establish that lighting caused them.</p></div>
          <div class=\"scope\">18 plots · 3 sites · one winter growing cycle</div>
        </section>
      </div>
    </article>
  </div>
  <script>
''' + js + '''
  </script>
</body>
</html>
'''
Path('output/slide.html').write_text(html)
