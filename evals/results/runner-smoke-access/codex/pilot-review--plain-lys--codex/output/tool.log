from pathlib import Path
import json
root = Path('.')
css = (root/'inputs/lys/lys.css').read_text()
js = (root/'inputs/lys/lys.iife.js').read_text()
notice = (root/'inputs/lys/NOTICE.md').read_text()
html = '''<"'!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Riverbank greenhouse lighting pilot | steering group</title>
<style>
'"''' + css + '''
</style>
<style>
:root { color-scheme: light; --ink:#162d35; --muted:#52676c; --paper:#f3f4ef; --green:#1f5b4c; --lime:#b7d58a; --amber:#e3ad54; --line:#d9dfd8; }
* { box-sizing:border-box; }
html, body { margin:0; width:100%; height:100%; background:var(--paper); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }
[data-lys] { --lys-backdrop:var(--paper); --lys-aspect-ratio:16 / 9; --lys-slide-padding:0; --lys-slide-max-width:100vw; --lys-slide-max-height:100vh; }
[data-lys] > article { background:var(--paper); color:var(--ink); padding:4.3cqi 5cqi 3.5cqi; display:flex; flex-direction:column; }
.slide { height:100%; display:flex; flex-direction:column; }
.kicker { display:flex; align-items:center; gap:.65em; color:var(--green); font-size:.72em; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
.kicker::before { content:\"\"; width:1.8em; height:3px; background:var(--amber); display:inline-block; }
h1 { font-size:2.46em; letter-spacing:-.045em; line-height:1.02; margin:.52em 0 .22em; max-width:18ch; }
.deck { color:var(--muted); font-size:1.02em; line-height:1.42; margin:0; max-width:72ch; }
.deck strong { color:var(--ink); }
.main { display:grid; grid-template-columns: .88fr 1.12fr; gap:2.8cqi; margin-top:2.15cqi; flex:1; min-height:0; }
.action { background:var(--ink); color:#f5f6ef; border-radius:1.05em; padding:1.45em 1.55em; display:flex; flex-direction:column; justify-content:space-between; }
.action .label { font-size:.68em; text-transform:uppercase; letter-spacing:.13em; font-weight:800; color:#b7d58a; }
.action h2 { font-size:1.55em; line-height:1.08; letter-spacing:-.025em; margin:.52em 0 .38em; }
.action p { font-size:.86em; line-height:1.4; margin:0; color:#d0d9d5; }
.action .rule { margin-top:1.05em; border-top:1px solid #40575a; padding-top:.8em; font-size:.76em; color:#dce5df; line-height:1.35; }
.action .rule strong { color:#fff; }
.evidence { display:flex; flex-direction:column; gap:.9em; min-height:0; }
.card { border:1px solid var(--line); background:#fffefa; border-radius:.95em; padding:1.02em 1.25em; }
.card-title { display:flex; justify-content:space-between; align-items:baseline; gap:1em; }
.card-title h2 { margin:0; font-size:.83em; text-transform:uppercase; letter-spacing:.1em; color:var(--muted); }
.card-title span { color:var(--muted); font-size:.69em; }
.median { display:flex; align-items:baseline; gap:.48em; margin-top:.35em; }
.median strong { font-size:2.34em; line-height:1; letter-spacing:-.06em; color:var(--green); }
.median span { font-size:.81em; color:var(--ink); font-weight:650; }
.range { margin:.88em .15em .15em; }
.track { position:relative; height:7px; background:#e4e9e3; border-radius:99px; margin:0 .45em; }
.segment { position:absolute; inset:0; background:linear-gradient(90deg,#a9b9ad,#63937f); border-radius:99px; }
.marker { position:absolute; top:50%; left:52.94%; transform:translate(-50%,-50%); width:17px; height:17px; border:3px solid white; outline:2px solid var(--green); background:var(--green); border-radius:50%; }
.range-labels { display:flex; justify-content:space-between; margin-top:.53em; color:var(--muted); font-size:.72em; }
.range-labels strong { color:var(--ink); }
.plots { display:grid; grid-template-columns:auto 1fr; gap:1.2em; align-items:center; }
.plots .big { color:var(--green); font-weight:800; font-size:1.86em; letter-spacing:-.05em; line-height:1; white-space:nowrap; }
.plots p { margin:0; color:var(--ink); font-size:.82em; line-height:1.35; }
.plots small { display:block; color:var(--muted); font-size:.8em; margin-top:.24em; }
.scope { display:flex; justify-content:space-between; gap:.8em; margin-top:auto; padding-top:.82em; border-top:1px solid var(--line); color:var(--muted); font-size:.71em; line-height:1.2; }
.scope strong { color:var(--ink); }
.footer { background:#e7ebe4; border-left:4px solid var(--amber); border-radius:.25em .55em .55em .25em; margin-top:1.25cqi; padding:.72em 1em; color:#354b50; font-size:.7em; line-height:1.34; }
.footer strong { color:var(--ink); }
@media (max-aspect-ratio: 4/3) {
 [data-lys] > article { font-size:clamp(.66rem,2.15cqi,1.1rem); }
 .main { grid-template-columns:.82fr 1.18fr; }
}
</style>
</head>
<body>
<main data-lys aria-label=\"Riverbank greenhouse lighting pilot steering group decision\">
  <article id=\"next-step\" aria-label=\"Authorize another measurement cycle\">
    <div class=\"slide\">
      <header>
        <div class=\"kicker\">Riverbank greenhouse lighting pilot <span aria-hidden=\"true\">/</span> steering group</div>
        <h1>Measure again before scaling.</h1>
        <p class=\"deck\"><strong>Authorize one further measurement cycle.</strong> The pilot shows a positive median yield difference, but its design cannot establish that lighting caused it.</p>
      </header>
      <div class=\"main\">
        <section class=\"action\" aria-labelledby=\"action-title\">
          <div>
            <div class=\"label\">Recommended next step</div>
            <h2 id=\"action-title\">Repeat the measurement; fill the decision gaps.</h2>
            <p>Track yield alongside <strong>installation cost</strong> and <strong>energy use</strong>, which this pilot did not measure. Use the next cycle to make the comparison more interpretable across sites.</p>
          </div>
          <div class=\"rule\"><strong>Do not approve wider installation on yield evidence alone.</strong> The pilot is an early signal, not a causal estimate or a full operating case.</div>
        </section>
        <section class=\"evidence\" aria-label=\"Pilot evidence and scope\">
          <div class=\"card\">
            <div class=\"card-title\"><h2>Observed yield difference</h2><span>versus each site's reference plots</span></div>
            <div class=\"median\"><strong>+6%</strong><span>reported median</span></div>
            <div class=\"range\" aria-label=\"Individual plot differences ranged from minus 3 percent to plus 14 percent; reported median plus 6 percent\">
              <div class=\"track\"><div class=\"segment\"></div><div class=\"marker\"></div></div>
              <div class=\"range-labels\"><span><strong>−3%</strong> low</span><span>individual plot range</span><span><strong>+14%</strong> high</span></div>
            </div>
          </div>
          <div class=\"card plots\">
            <div class=\"big\">12 / 18</div>
            <p>plots had a positive yield difference.<small>6 of 18 did not have a positive difference; that does not mean all six were negative.</small></p>
          </div>
          <div class=\"scope\" aria-label=\"Pilot scope\">
            <span><strong>18</strong> greenhouse plots</span>
            <span><strong>3</strong> sites</span>
            <span><strong>1</strong> winter growing cycle</span>
          </div>
        </section>
      </div>
      <footer class=\"footer\"><strong>Limits:</strong> plots were not randomly assigned; crop mix and baseline conditions differed between sites. Yield differences may reflect those differences. Installation cost and energy use remain unmeasured.</footer>
    </div>
  </article>
