+    }
+    @media screen and (max-width: 1000px), screen and (max-height: 650px) {
+      [data-lys] > article { padding: 38px 40px 26px; }
+      h1 { font-size: 65px; }
+      .title-details { gap: 32px; }
+      .statement { font-size: 36px; }
+      .technologies { gap: 30px; }
+    }
+    @media screen and (max-width: 600px) {
+      [data-lys] > article { padding: 30px 24px 24px; font-size: 18px; line-height: 1.45; }
+      [data-lys] > article + article { margin-top: 12px; }
+      h1 { font-size: 50px; line-height: 1.04; }
+      .title-main { margin: 18px 0 42px; }
+      .title-details { grid-template-columns: minmax(0, 1fr); gap: 30px; }
+      .person-name { font-size: 21px; }
+      .section-title { font-size: 21px; }
+      .section-title::before { margin-bottom: 17px; }
+      .statement { font-size: 29px; line-height: 1.21; margin-top: 28px; }
+      .context { margin-top: 28px; padding-top: 22px; }
+      .context li { margin-top: 14px; }
+      .trade-title { font-size: 32px; line-height: 1.12; }
+      .technologies { grid-template-columns: minmax(0, 1fr); gap: 32px; margin-top: 30px; }
+      .technology { padding-top: 20px; }
+      .technology h3 { font-size: 22px; margin-bottom: 20px; }
+      .technology li { margin-top: 13px; }
+      .white-paper { margin-top: 32px; padding-top: 22px; }
+      .white-paper p { font-size: 22px; }
+      .white-paper a { font-size: 20px; }
+      .source { font-size: 12px; margin-top: 32px; padding-top: 12px; }
+    }
+    @media print {
+      @page { size: 13.333333in 7.5in; margin: 0; }
+      html, body { width: 13.333333in; background: white; }
+      .deck-nav { display: none; }
+      [data-lys], [data-lys][data-lys-mode] { display: block; height: auto; overflow: visible; background: white; }
+      [data-lys] > article, [data-lys][data-lys-mode] > article {
+        position: relative; top: auto; left: auto; transform: none; opacity: 1; pointer-events: auto;
+        width: 13.333333in; height: 7.5in; aspect-ratio: 16 / 9; max-height: none; overflow: visible;
+        padding: 52px 64px 30px; margin: 0; font-size: 22px;
+        break-inside: avoid; break-after: page; print-color-adjust: exact; -webkit-print-color-adjust: exact;
+      }
+      [data-lys] > article + article { margin-top: 0; }
+      [data-lys] > article:last-of-type { break-after: auto; }
+      h1 { font-size: 82px; }
+      .title-main { margin: 16px 0 auto; }
+      .title-details { padding-top: 30px; }
+      .statement { font-size: 43px; max-width: 37ch; margin-top: 32px; }
+      .context { margin-top: 30px; padding-top: 22px; }
+      .trade-title { font-size: 40px; }
+      .technologies { margin-top: 36px; }
+      .technology h3 { font-size: 26px; margin-bottom: 22px; }
+      .technology li { margin-top: 12px; font-size: 22px; }
+      .summary .statement { font-size: 46px; max-width: 34ch; }
+      .white-paper { margin-top: auto; }
+      .source { margin-top: auto; padding-top: 22px; font-size: 12px; }
+      .title-slide .source, .summary .source { margin-top: 28px; }
+    }
+  </style>
+</head>
+<body>
+  <nav class="deck-nav" aria-label="Slides">
+    <a href="#mars-surface-power" aria-label="Slide 1: Mars Surface Power" title="Mars Surface Power">01</a>
+    <a href="#introduction" aria-label="Slide 2: Introduction" title="Introduction">02</a>
+    <a href="#technology-trade-space" aria-label="Slide 3: Technology Trade Space and Down Select" title="Technology Trade Space and Down Select">03</a>
+    <a href="#summary-of-decision" aria-label="Slide 4: Summary of Decision" title="Summary of Decision">04</a>
+  </nav>
+  <div data-lys aria-label="Mars Surface Power">
+    <article id="mars-surface-power" class="title-slide" data-transition="direct" data-notes="Michael Chappell, Deputy Mars Architecture Lead, Strategy and Architecture Office, NASA – ESDMD – SAO. Presented at the Moon to Mars Architecture Workshops in February 2025.">
+      <div class="title-main"><h1>Mars Surface Power</h1></div>
+      <div class="title-details">
+        <div>
+          <p class="person-name">Michael Chappell</p>
+          <p>Deputy Mars Architecture Lead<br>Strategy and Architecture Office<br>NASA – ESDMD – SAO</p>
+        </div>
+        <div>
+          <p class="event-date">February 2025</p>
+          <p>Moon to Mars Architecture Workshops</p>
+        </div>
+      </div>
+      __FOOTER__
+    </article>
+    <article id="introduction" class="introduction" data-transition="direct" data-notes="Nuclear fission power selected as primary surface power generation technology for initial crewed missions to Mars. This is a 2024 Architecture Concept Review outcome, an exercise in process as much as decision outcome, and is documented in Appendix B of the Architecture Definition Document.">
+      <h2 class="section-title">Introduction</h2>
+      <p class="statement"><strong>Nuclear fission power</strong> selected as primary surface power generation technology for initial crewed missions to Mars</p>
+      <div class="context">
+        <ul>
+          <li>2024 Architecture Concept Review outcome</li>
+          <li>Exercise in process as much as decision outcome</li>
+          <li>Documented in Appendix B of the Architecture Definition Document</li>
+        </ul>
+      </div>
+      __FOOTER__
+    </article>
+    <article id="technology-trade-space" class="trade-space" data-transition="direct" data-notes="The supplied trade space has two peer categories: Nuclear Technologies and Non-Nuclear Technologies. Struck-out entries are excluded technologies. The unstruck entries are Fission surface power systems (FSP) and Photovoltaic array with energy storage.">
+      <h2 class="trade-title">Technology Trade Space and Down Select</h2>
+      <div class="technologies">
+        <div class="technology">
+          <h3>Nuclear Technologies</h3>
+          <ul>
+            <li>Fission surface power systems (FSP)</li>
+            <li><s>Radioisotope thermoelectric generators (RTGs)</s></li>
+          </ul>
+        </div>
+        <div class="technology">
+          <h3>Non-Nuclear Technologies</h3>
+          <ul>
+            <li>Photovoltaic array with energy storage</li>
+            <li><s>Primary batteries</s></li>
+            <li><s>Primary fuel cells</s></li>
+            <li><s>Wind power generation</s></li>
+            <li><s>Geothermal power generation</s></li>
+            <li><s>Biogeneration concepts</s></li>
+          </ul>
+        </div>
+      </div>
+      __FOOTER__
+    </article>
+    <article id="summary-of-decision" class="summary" data-transition="direct" data-notes="Nuclear fission power selected as primary surface power generation technology for initial crewed missions to Mars. Read the White Paper: https://bit.ly/3VN2Z1r.">
+      <h2 class="section-title">Summary of Decision</h2>
+      <p class="statement"><strong>Nuclear fission power</strong> selected as primary surface power generation technology for initial crewed missions to Mars</p>
+      <div class="white-paper">
+        <p>Read the White Paper</p>
+        <a href="https://bit.ly/3VN2Z1r">https://bit.ly/3VN2Z1r</a>
+      </div>
+      __FOOTER__
+    </article>
+  </div>
+  <script id="lys-runtime-js">
+__LYS_JS__
+  </script>
+  <script id="reading-mode-adapter">
+    (() => {
+      const surface = document.querySelector('[data-lys]');
+      const slides = [...surface.querySelectorAll(':scope > article')];
+      const nav = document.querySelector('.deck-nav');
+      const links = [...nav.querySelectorAll('a')];
+      const reading = matchMedia('(max-width: 1000px), (max-height: 650px)');
+      let deck = null;
+      let savedIndex = 0;
+      let printing = false;
+
+      function synchronize() {
+        slides.forEach((slide, index) => { slide.inert = !!deck && index !== deck.current; });
+        links.forEach((link, index) => {
+          if (deck && index === deck.current) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        });
+      }
+      function destroyDeck() {
+        if (deck) { savedIndex = deck.current; deck.destroy(); deck = null; }
+        document.documentElement.classList.remove('presentation');
+        synchronize();
+      }
+      function nearestSlide() {
+        let best = 0, distance = Infinity;
+        slides.forEach((slide, index) => {
+          const next = Math.abs(slide.getBoundingClientRect().top - 64);
+          if (next < distance) { best = index; distance = next; }
+        });
+        return best;
+      }
+      function adapt(initial = false) {
+        if (printing) return;
+        if (reading.matches) {
+          const hadDeck = !!deck;
+          destroyDeck();
+          if (!initial && hadDeck) slides[savedIndex].scrollIntoView({block: 'start'});
+        } else {
+          if (!deck) {
+            if (!initial) savedIndex = nearestSlide();
+            document.documentElement.classList.add('presentation');
+            window.scrollTo(0, 0);
+            deck = Lys.Lys.from(surface);
+            deck.goTo(savedIndex);
+          } else document.documentElement.classList.add('presentation');
+          synchronize();
+        }
+      }
+      function start() {
+        deck = Lys.Lys.from(surface);
+        savedIndex = deck.current;
+        surface.addEventListener('lys:slidechange', () => {
+          if (deck) { savedIndex = deck.current; synchronize(); }
+        });
+        adapt(true);
+        nav.addEventListener('click', event => {
+          const link = event.target.closest('a');
+          if (!link || !deck || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
+          event.preventDefault();
+          deck.goTo(link.hash.slice(1));
+          deck.slide.focus({preventScroll: true});
+        });
+        nav.addEventListener('keydown', event => {
+          if (!deck || event.ctrlKey || event.metaKey || event.altKey) return;
+          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') deck.next();
+          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') deck.prev();
+          else if (event.key === 'Home') deck.goTo(0);
+          else if (event.key === 'End') deck.goTo(deck.total - 1);
+          else return;
+          event.preventDefault();
+        });
+        reading.addEventListener('change', () => adapt());
+        window.addEventListener('beforeprint', () => { printing = true; destroyDeck(); });
+        window.addEventListener('afterprint', () => { printing = false; adapt(true); });
+      }
+      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, {once: true});
+      else start();
+    })();
+  </script>
+</body>
+</html>
+'''
+
+html = html.replace('__NOTICE__', notice).replace('__LYS_CSS__', css).replace('__LYS_JS__', js).replace('__FOOTER__', footer)
+(ROOT / 'output/slide.html').write_text(html)
+decision = {
+  'protocol': 'kata-eval-decision/v1',
+  'audience_question': 'What surface power technology did NASA select for initial crewed missions to Mars, and which technology categories were considered?',
+  'form': 'Single-focus title; decision lead above supporting context; equal peer technology columns; decision lead with White Paper support.',
+  'fit_rationale': 'Large decision text retains the full initial-crewed-missions qualification. Matching category headings, widths, rules and type keep the two technology categories equal, while all six exclusions retain their strike-through. The title groups the presenter and workshop details. A warm paper field, dark ink and restrained rust emphasis provide a cohesive text-only presentation.',
+  'tradeoff': 'The longer decision statement sits above its context rather than beside it to preserve readable line lengths. The technology lists use equal columns on slides and stack in their supplied order on phones, trading simultaneous comparison for natural-size text and scrolling access.',
+  'caveats': [
+    'The selection is primary surface power generation technology for initial crewed missions to Mars.',
+    'The two technology categories are peers; struck-out entries are excluded technologies.',
+    'Historical text excerpt: NASA · Michael Chappell · February 2025. No NASA endorsement is implied.',
+    'Only the supplied source page 1, page 2, page 5 upper lists and page 13 text are included.'
+  ]
+}
+(ROOT / 'output/decision.json').write_text(json.dumps(decision, ensure_ascii=False, indent=2) + '\n')
diff --git a/qa/runtime-check.cjs b/qa/runtime-check.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..e0a8847fcb9d8030fa8f8686c0aadb9b15f51498
--- /dev/null
+++ b/qa/runtime-check.cjs
@@ -0,0 +1,115 @@
+const fs = require('node:fs');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+
+// A small DOM harness exercises the shipped JavaScript without opening a browser.
+// It cannot test layout, rendering, native keyboard routing or a screen reader.
+function run(startReading) {
+  let scrollY = 0;
+  class Target {
+    constructor() { this.listeners = new Map(); }
+    addEventListener(type, callback, options) {
+      if (!this.listeners.has(type)) this.listeners.set(type, []);
+      this.listeners.get(type).push({callback, once: !!options?.once});
+    }
+    removeEventListener(type, callback) {
+      this.listeners.set(type, (this.listeners.get(type) || []).filter(e => e.callback !== callback));
+    }
+    dispatchEvent(event) {
+      event.target ||= this;
+      for (const listener of [...(this.listeners.get(event.type) || [])]) {
+        listener.callback(event);
+        if (listener.once) this.removeEventListener(event.type, listener.callback);
+      }
+      return true;
+    }
+  }
+  class Element extends Target {
+    constructor(tag, id = '') {
+      super(); this.tagName = tag; this.id = id; this.attrs = new Map(); this.children = [];
+      this.dataset = {}; this.style = {}; this.inert = false; this.classes = new Set();
+      this.classList = {add: (...x) => x.forEach(v => this.classes.add(v)), remove: (...x) => x.forEach(v => this.classes.delete(v))};
+    }
+    setAttribute(name, value) { this.attrs.set(name, String(value)); }
+    getAttribute(name) { return this.attrs.get(name) ?? null; }
+    hasAttribute(name) { return this.attrs.has(name); }
+    removeAttribute(name) { this.attrs.delete(name); }
+    appendChild(child) { this.children.push(child); child.parent = this; }
+    remove() { this.parent.children = this.parent.children.filter(c => c !== this); }
+    focus() { document.activeElement = this; }
+    closest(selector) { return selector === 'a' && this.tagName === 'a' ? this : null; }
+    querySelector(selector) {
+      if (selector.includes('h1')) return {textContent: this.id};
+      return null;
+    }
+    querySelectorAll(selector) {
+      if (selector === ':scope > article') return this.children.filter(c => c.tagName === 'article');
+      if (selector === 'a') return this.children;
+      return [];
+    }
+    getBoundingClientRect() { return {top: 64 + slides.indexOf(this) * 900 - scrollY}; }
+    scrollIntoView() { scrollY = slides.indexOf(this) * 900; }
+  }
+  const document = new Target();
+  document.readyState = 'loading'; document.documentElement = new Element('html');
+  const surface = new Element('div'); surface.setAttribute('aria-label', 'Mars Surface Power');
+  const ids = ['mars-surface-power', 'introduction', 'technology-trade-space', 'summary-of-decision'];
+  const slides = ids.map(id => { const e = new Element('article', id); e.dataset.transition = 'direct'; surface.appendChild(e); return e; });
+  const nav = new Element('nav');
+  const links = ids.map(id => { const e = new Element('a'); e.hash = '#' + id; nav.appendChild(e); return e; });
+  document.querySelector = query => query === '[data-lys]' ? surface : nav;
+  document.querySelectorAll = () => [surface]; document.createElement = tag => new Element(tag);
+  const window = new Target(); window.scrollTo = (x, y) => { scrollY = y; };
+  const reading = new Target(); reading.matches = startReading;
+  const location = {hash: ''};
+  class CustomEvent { constructor(type, init = {}) { this.type = type; Object.assign(this, init); } }
+  const context = vm.createContext({document, window, location, CustomEvent,
+    matchMedia: query => query.includes('max-width') ? reading : {matches: false},
+    history: {replaceState: (a, b, hash) => { location.hash = hash; }},
+    requestAnimationFrame: () => 1, cancelAnimationFrame: () => {}, console
+  });
+  vm.runInContext(fs.readFileSync('qa/lys-runtime-js.js', 'utf8'), context);
+  vm.runInContext(fs.readFileSync('qa/reading-mode-adapter.js', 'utf8'), context);
+  document.dispatchEvent({type: 'DOMContentLoaded'});
+  const fire = (target, type, extra = {}) => {
+    const event = {type, preventDefault() { this.defaultPrevented = true; }, ...extra};
+    target.dispatchEvent(event); return event;
+  };
+  const isReading = () => {
+    assert(!surface.hasAttribute('data-lys-mode'));
+    assert(!document.documentElement.classes.has('presentation'));
+    slides.forEach(s => { assert(!s.hasAttribute('aria-hidden')); assert(!s.inert); });
+  };
+  const current = index => {
+    assert.equal(surface.getAttribute('data-lys-current'), String(index));
+    slides.forEach((s, i) => {
+      assert.equal(s.hasAttribute('data-lys-active'), i === index);
+      assert.equal(s.getAttribute('aria-hidden'), i === index ? null : 'true');
+      assert.equal(s.inert, i !== index);
+      assert.equal(links[i].getAttribute('aria-current'), i === index ? 'page' : null);
+    });
+  };
+  if (startReading) { isReading(); reading.matches = false; fire(reading, 'change'); }
+  current(0);
+  fire(surface, 'keydown', {key: 'ArrowRight'}); current(1);
+  fire(surface, 'keydown', {key: 'ArrowLeft'}); current(0);
+  fire(surface, 'keydown', {key: 'End'}); current(3);
+  fire(surface, 'keydown', {key: 'Home'}); current(0);
+  fire(surface, 'keydown', {key: ' '}); current(1);
+  fire(surface, 'keydown', {key: ' ', shiftKey: true}); current(0);
+  assert(fire(nav, 'click', {target: links[2]}).defaultPrevented); current(2);
+  assert.equal(document.activeElement, slides[2]);
+  fire(nav, 'keydown', {key: 'ArrowRight'}); current(3);
+  fire(nav, 'keydown', {key: 'Home'}); current(0);
+  fire(nav, 'click', {target: links[2]}); current(2);
+  reading.matches = true; fire(reading, 'change'); isReading();
+  assert(!fire(nav, 'click', {target: links[1]}).defaultPrevented);
+  reading.matches = false; fire(reading, 'change'); current(2);
+  fire(window, 'beforeprint'); isReading();
+  fire(window, 'afterprint'); current(2);
+  assert.equal(surface.children.filter(c => c.tagName !== 'article').length, 1);
+  console.log(`PASS: ${startReading ? 'phone' : 'desktop'} startup, arrow/Home/End/Space handlers, navigation links, inactive focus guards, reading-mode cleanup, resize restoration, print lifecycle.`);
+}
+run(false);
+run(true);
+console.log('LIMIT: JavaScript state checks use a DOM harness; no browser pixels, actual Tab traversal, native printing or assistive technology were tested.');
diff --git a/qa/verify.py b/qa/verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..d63d0c9ff2416fc557a794c6d14b0bde9960d9eb
--- /dev/null
+++ b/qa/verify.py
@@ -0,0 +1,87 @@
+from html.parser import HTMLParser
+from pathlib import Path
+import json, re
+
+ROOT = Path(__file__).resolve().parent.parent
+source = (ROOT / 'output/slide.html').read_text()
+brief = (ROOT / 'inputs/brief.md').read_text()
+
+class Element:
+    def __init__(self, tag, attrs):
+        self.tag, self.attrs, self.children = tag, dict(attrs), []
+    def text(self):
+        return ''.join(c.text() if isinstance(c, Element) else c for c in self.children)
+    def all(self, tag):
+        result = []
+        for child in self.children:
+            if isinstance(child, Element):
+                if child.tag == tag: result.append(child)
+                result += child.all(tag)
+        return result
+
+class Parser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.root = Element('root', [])
+        self.stack = [self.root]
+    def handle_starttag(self, tag, attrs):
+        el = Element(tag, attrs)
+        self.stack[-1].children.append(el)
+        if tag == 'br': self.stack[-1].children.append(' ')
+        if tag not in {'meta', 'link', 'br', 'hr', 'img', 'input'}: self.stack.append(el)
+    def handle_endtag(self, tag):
+        assert self.stack[-1].tag == tag, (tag, self.stack[-1].tag)
+        self.stack.pop()
+    def handle_data(self, text): self.stack[-1].children.append(text)
+
+def normalize(text): return re.sub(r'\s+', ' ', text).strip()
+parser = Parser()
+parser.feed(source)
+root = parser.root
+articles = root.all('article')
+assert len(articles) == 4
+deck = next(el for el in root.all('div') if 'data-lys' in el.attrs)
+assert [el for el in deck.children if isinstance(el, Element)] == articles
+parts = re.split(r'## Slide \d[^\n]*\n', brief)[1:]
+for article, part in zip(articles, parts):
+    expected = []
+    for line in part.splitlines():
+        if line.strip(): expected.append(re.sub(r'^(Title: |- )', '', line).replace('~~', ''))
+    content = [child for child in article.children if not isinstance(child, Element) or child.tag != 'footer']
+    actual = normalize(''.join(child.text() if isinstance(child, Element) else child for child in content))
+    assert actual == normalize(' '.join(expected)), (article.attrs['id'], actual, expected)
+    assert article.attrs.get('data-notes')
+    assert any(article.all('h' + str(n)) for n in range(1, 7))
+
+expected_strikes = re.findall(r'~~(.*?)~~', brief)
+assert [el.text() for el in root.all('s')] == expected_strikes
+assert len(expected_strikes) == 6
+assert len(articles[2].all('h3')) == 2
+assert root.all('html')[0].attrs['lang'] == 'en'
+assert any(el.attrs.get('charset') == 'UTF-8' for el in root.all('meta'))
+assert any(el.attrs.get('name') == 'viewport' for el in root.all('meta'))
+assert (ROOT / 'inputs/lys/NOTICE.md').read_text() in source
+for file, id, tag in [('lys.css', 'lys-runtime-css', 'style'), ('lys.iife.js', 'lys-runtime-js', 'script')]:
+    actual = next(el.text() for el in root.all(tag) if el.attrs.get('id') == id)
+    assert actual.strip() == (ROOT / 'inputs/lys' / file).read_text().strip()
+for el in root.all('script'):
+    assert 'src' not in el.attrs
+    (ROOT / 'qa' / (el.attrs['id'] + '.js')).write_text(el.text())
+assert not root.all('link') and not root.all('img')
+assert not re.search(r'\son\w+\s*=', source)
+assert not re.search(r'<[^>]+\bdata-lys-(active|current|mode)\b', source)
+theme = next(el.text() for el in root.all('style') if el.attrs.get('id') == 'presentation-theme')
+assert '--_lys-' not in theme
+assert 'url(' not in theme and '@import' not in theme
+assert '@media print' in theme and 'break-after: page' in theme
+assert '@media screen and (max-width: 600px)' in theme
+assert '* { margin: 0; box-sizing: border-box; }' in theme
+
+decision = json.loads((ROOT / 'output/decision.json').read_text())
+assert set(decision) == {'protocol', 'audience_question', 'form', 'fit_rationale', 'tradeoff', 'caveats'}
+assert decision['protocol'] == 'kata-eval-decision/v1'
+assert decision['audience_question'] == 'What surface power technology did NASA select for initial crewed missions to Mars, and which technology categories were considered?'
+assert all(isinstance(decision[key], str) for key in decision if key != 'caveats')
+assert isinstance(decision['caveats'], list) and all(isinstance(v, str) for v in decision['caveats'])
+print('PASS: four slides in order; exact supplied wording; six exclusions; qualifiers; headings and notes; standalone runtime and notice; no external dependencies; decision schema.')
+print('SOURCE REVIEW ONLY: responsive, no-JavaScript and print CSS. No browser layout measurements or rendered visual checks performed.')

