+    <article id="technology-trade-space" class="trade-space" data-transition="direct" data-notes="The supplied trade space has two peer categories: Nuclear Technologies and Non-Nuclear Technologies. Struck-out entries are excluded technologies. The unstruck entries are Fission surface power systems (FSP) and Photovoltaic array with energy storage.">
+      <h2 class="trade-title">Technology Trade Space and Down Select</h2>
+      <div class="technologies">
+        <div class="technology">
+          <h3>Nuclear Technologies</h3>
+          <ul>
+            <li>Fission surface power systems (FSP)</li>
+            <li><s>Radioisotope thermoelectric generators (RTGs)</s></li>
+          </ul>
+        </div>
+        <div class="technology">
+          <h3>Non-Nuclear Technologies</h3>
+          <ul>
+            <li>Photovoltaic array with energy storage</li>
+            <li><s>Primary batteries</s></li>
+            <li><s>Primary fuel cells</s></li>
+            <li><s>Wind power generation</s></li>
+            <li><s>Geothermal power generation</s></li>
+            <li><s>Biogeneration concepts</s></li>
+          </ul>
+        </div>
+      </div>
+      __FOOTER__
+    </article>
+    <article id="summary-of-decision" class="summary" data-transition="direct" data-notes="Nuclear fission power selected as primary surface power generation technology for initial crewed missions to Mars. Read the White Paper: https://bit.ly/3VN2Z1r.">
+      <h2 class="section-title">Summary of Decision</h2>
+      <p class="statement"><strong>Nuclear fission power</strong> selected as primary surface power generation technology for initial crewed missions to Mars</p>
+      <div class="white-paper">
+        <p>Read the White Paper</p>
+        <a href="https://bit.ly/3VN2Z1r">https://bit.ly/3VN2Z1r</a>
+      </div>
+      __FOOTER__
+    </article>
+  </div>
+  <script id="lys-runtime-js">
+__LYS_JS__
+  </script>
+  <script id="reading-mode-adapter">
+    (() => {
+      const surface = document.querySelector('[data-lys]');
+      const slides = [...surface.querySelectorAll(':scope > article')];
+      const nav = document.querySelector('.deck-nav');
+      const links = [...nav.querySelectorAll('a')];
+      const reading = matchMedia('(max-width: 1000px), (max-height: 650px)');
+      let deck = null;
+      let savedIndex = 0;
+      let printing = false;
+
+      function synchronize() {
+        slides.forEach((slide, index) => { slide.inert = !!deck && index !== deck.current; });
+        links.forEach((link, index) => {
+          if (deck && index === deck.current) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        });
+      }
+      function destroyDeck() {
+        if (deck) { savedIndex = deck.current; deck.destroy(); deck = null; }
+        document.documentElement.classList.remove('presentation');
+        synchronize();
+      }
+      function nearestSlide() {
+        let best = 0, distance = Infinity;
+        slides.forEach((slide, index) => {
+          const next = Math.abs(slide.getBoundingClientRect().top - 64);
+          if (next < distance) { best = index; distance = next; }
+        });
+        return best;
+      }
+      function adapt(initial = false) {
+        if (printing) return;
+        if (reading.matches) {
+          const hadDeck = !!deck;
+          destroyDeck();
+          if (!initial && hadDeck) slides[savedIndex].scrollIntoView({block: 'start'});
+        } else {
+          if (!deck) {
+            if (!initial) savedIndex = nearestSlide();
+            document.documentElement.classList.add('presentation');
+            window.scrollTo(0, 0);
+            deck = Lys.Lys.from(surface);
+            deck.goTo(savedIndex);
+          } else document.documentElement.classList.add('presentation');
+          synchronize();
+        }
+      }
+      function start() {
+        deck = Lys.Lys.from(surface);
+        savedIndex = deck.current;
+        surface.addEventListener('lys:slidechange', () => {
+          if (deck) { savedIndex = deck.current; synchronize(); }
+        });
+        adapt(true);
+        nav.addEventListener('click', event => {
+          const link = event.target.closest('a');
+          if (!link || !deck || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
+          event.preventDefault();
+          deck.goTo(link.hash.slice(1));
+          deck.slide.focus({preventScroll: true});
+        });
+        nav.addEventListener('keydown', event => {
+          if (!deck || event.ctrlKey || event.metaKey || event.altKey) return;
+          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') deck.next();
+          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') deck.prev();
+          else if (event.key === 'Home') deck.goTo(0);
+          else if (event.key === 'End') deck.goTo(deck.total - 1);
+          else return;
+          event.preventDefault();
+        });
+        reading.addEventListener('change', () => adapt());
+        window.addEventListener('beforeprint', () => { printing = true; destroyDeck(); });
+        window.addEventListener('afterprint', () => { printing = false; adapt(true); });
+      }
+      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, {once: true});
+      else start();
+    })();
+  </script>
+</body>
+</html>
+'''
+
+html = html.replace('__NOTICE__', notice).replace('__LYS_CSS__', css).replace('__LYS_JS__', js).replace('__FOOTER__', footer)
+(ROOT / 'output/slide.html').write_text(html)
+decision = {
+  'protocol': 'kata-eval-decision/v1',
+  'audience_question': 'What surface power technology did NASA select for initial crewed missions to Mars, and which technology categories were considered?',
+  'form': 'Single-focus title; decision lead above supporting context; equal peer technology columns; decision lead with White Paper support.',
+  'fit_rationale': 'Large decision text retains the full initial-crewed-missions qualification. Matching category headings, widths, rules and type keep the two technology categories equal, while all six exclusions retain their strike-through. The title groups the presenter and workshop details. A warm paper field, dark ink and restrained rust emphasis provide a cohesive text-only presentation.',
+  'tradeoff': 'The longer decision statement sits above its context rather than beside it to preserve readable line lengths. The technology lists use equal columns on slides and stack in their supplied order on phones, trading simultaneous comparison for natural-size text and scrolling access.',
+  'caveats': [
+    'The selection is primary surface power generation technology for initial crewed missions to Mars.',
+    'The two technology categories are peers; struck-out entries are excluded technologies.',
+    'Historical text excerpt: NASA · Michael Chappell · February 2025. No NASA endorsement is implied.',
+    'Only the supplied source page 1, page 2, page 5 upper lists and page 13 text are included.'
+  ]
+}
+(ROOT / 'output/decision.json').write_text(json.dumps(decision, ensure_ascii=False, indent=2) + '\n')
