+      function synchronize() {
+        slides.forEach((slide, index) => { slide.inert = !!deck && index !== deck.current; });
+        links.forEach((link, index) => {
+          if (deck && index === deck.current) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        });
+      }
+      function destroyDeck() {
+        if (deck) { savedIndex = deck.current; deck.destroy(); deck = null; }
+        document.documentElement.classList.remove('presentation');
+        synchronize();
+      }
+      function nearestSlide() {
+        let best = 0, distance = Infinity;
+        slides.forEach((slide, index) => {
+          const next = Math.abs(slide.getBoundingClientRect().top - 64);
+          if (next < distance) { best = index; distance = next; }
+        });
+        return best;
+      }
+      function adapt(initial = false) {
+        if (printing) return;
+        if (reading.matches) {
+          const hadDeck = !!deck;
+          destroyDeck();
+          if (!initial && hadDeck) slides[savedIndex].scrollIntoView({block: 'start'});
+        } else {
+          if (!deck) {
+            if (!initial) savedIndex = nearestSlide();
+            document.documentElement.classList.add('presentation');
+            window.scrollTo(0, 0);
+            deck = Lys.Lys.from(surface);
+            deck.goTo(savedIndex);
+          } else document.documentElement.classList.add('presentation');
+          synchronize();
+        }
+      }
+      function start() {
+        deck = Lys.Lys.from(surface);
+        savedIndex = deck.current;
+        surface.addEventListener('lys:slidechange', () => {
+          if (deck) { savedIndex = deck.current; synchronize(); }
+        });
+        adapt(true);
+        nav.addEventListener('click', event => {
+          const link = event.target.closest('a');
+          if (!link || !deck || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
+          event.preventDefault();
+          deck.goTo(link.hash.slice(1));
+          deck.slide.focus({preventScroll: true});
+        });
+        nav.addEventListener('keydown', event => {
+          if (!deck || event.ctrlKey || event.metaKey || event.altKey) return;
+          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') deck.next();
+          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') deck.prev();
+          else if (event.key === 'Home') deck.goTo(0);
+          else if (event.key === 'End') deck.goTo(deck.total - 1);
+          else return;
+          event.preventDefault();
+        });
+        reading.addEventListener('change', () => adapt());
+        window.addEventListener('beforeprint', () => { printing = true; destroyDeck(); });
+        window.addEventListener('afterprint', () => { printing = false; adapt(true); });
+      }
+      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, {once: true});
+      else start();
+    })();
