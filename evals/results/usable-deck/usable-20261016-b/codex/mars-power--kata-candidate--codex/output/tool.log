index 0000000000000000000000000000000000000000..e0a8847fcb9d8030fa8f8686c0aadb9b15f51498
--- /dev/null
+++ b/qa/runtime-check.cjs
@@ -0,0 +1,115 @@
+const fs = require('node:fs');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+
+// A small DOM harness exercises the shipped JavaScript without opening a browser.
+// It cannot test layout, rendering, native keyboard routing or a screen reader.
+function run(startReading) {
+  let scrollY = 0;
+  class Target {
+    constructor() { this.listeners = new Map(); }
+    addEventListener(type, callback, options) {
+      if (!this.listeners.has(type)) this.listeners.set(type, []);
+      this.listeners.get(type).push({callback, once: !!options?.once});
+    }
+    removeEventListener(type, callback) {
+      this.listeners.set(type, (this.listeners.get(type) || []).filter(e => e.callback !== callback));
+    }
+    dispatchEvent(event) {
+      event.target ||= this;
+      for (const listener of [...(this.listeners.get(event.type) || [])]) {
+        listener.callback(event);
+        if (listener.once) this.removeEventListener(event.type, listener.callback);
+      }
+      return true;
+    }
+  }
+  class Element extends Target {
+    constructor(tag, id = '') {
+      super(); this.tagName = tag; this.id = id; this.attrs = new Map(); this.children = [];
+      this.dataset = {}; this.style = {}; this.inert = false; this.classes = new Set();
+      this.classList = {add: (...x) => x.forEach(v => this.classes.add(v)), remove: (...x) => x.forEach(v => this.classes.delete(v))};
+    }
+    setAttribute(name, value) { this.attrs.set(name, String(value)); }
+    getAttribute(name) { return this.attrs.get(name) ?? null; }
+    hasAttribute(name) { return this.attrs.has(name); }
+    removeAttribute(name) { this.attrs.delete(name); }
+    appendChild(child) { this.children.push(child); child.parent = this; }
+    remove() { this.parent.children = this.parent.children.filter(c => c !== this); }
+    focus() { document.activeElement = this; }
+    closest(selector) { return selector === 'a' && this.tagName === 'a' ? this : null; }
+    querySelector(selector) {
+      if (selector.includes('h1')) return {textContent: this.id};
+      return null;
+    }
+    querySelectorAll(selector) {
+      if (selector === ':scope > article') return this.children.filter(c => c.tagName === 'article');
+      if (selector === 'a') return this.children;
+      return [];
+    }
+    getBoundingClientRect() { return {top: 64 + slides.indexOf(this) * 900 - scrollY}; }
+    scrollIntoView() { scrollY = slides.indexOf(this) * 900; }
+  }
+  const document = new Target();
+  document.readyState = 'loading'; document.documentElement = new Element('html');
+  const surface = new Element('div'); surface.setAttribute('aria-label', 'Mars Surface Power');
+  const ids = ['mars-surface-power', 'introduction', 'technology-trade-space', 'summary-of-decision'];
+  const slides = ids.map(id => { const e = new Element('article', id); e.dataset.transition = 'direct'; surface.appendChild(e); return e; });
+  const nav = new Element('nav');
+  const links = ids.map(id => { const e = new Element('a'); e.hash = '#' + id; nav.appendChild(e); return e; });
+  document.querySelector = query => query === '[data-lys]' ? surface : nav;
+  document.querySelectorAll = () => [surface]; document.createElement = tag => new Element(tag);
+  const window = new Target(); window.scrollTo = (x, y) => { scrollY = y; };
+  const reading = new Target(); reading.matches = startReading;
+  const location = {hash: ''};
+  class CustomEvent { constructor(type, init = {}) { this.type = type; Object.assign(this, init); } }
+  const context = vm.createContext({document, window, location, CustomEvent,
+    matchMedia: query => query.includes('max-width') ? reading : {matches: false},
+    history: {replaceState: (a, b, hash) => { location.hash = hash; }},
+    requestAnimationFrame: () => 1, cancelAnimationFrame: () => {}, console
+  });
+  vm.runInContext(fs.readFileSync('qa/lys-runtime-js.js', 'utf8'), context);
+  vm.runInContext(fs.readFileSync('qa/reading-mode-adapter.js', 'utf8'), context);
+  document.dispatchEvent({type: 'DOMContentLoaded'});
+  const fire = (target, type, extra = {}) => {
+    const event = {type, preventDefault() { this.defaultPrevented = true; }, ...extra};
+    target.dispatchEvent(event); return event;
+  };
+  const isReading = () => {
+    assert(!surface.hasAttribute('data-lys-mode'));
+    assert(!document.documentElement.classes.has('presentation'));
+    slides.forEach(s => { assert(!s.hasAttribute('aria-hidden')); assert(!s.inert); });
+  };
+  const current = index => {
+    assert.equal(surface.getAttribute('data-lys-current'), String(index));
+    slides.forEach((s, i) => {
+      assert.equal(s.hasAttribute('data-lys-active'), i === index);
+      assert.equal(s.getAttribute('aria-hidden'), i === index ? null : 'true');
+      assert.equal(s.inert, i !== index);
+      assert.equal(links[i].getAttribute('aria-current'), i === index ? 'page' : null);
+    });
+  };
+  if (startReading) { isReading(); reading.matches = false; fire(reading, 'change'); }
+  current(0);
+  fire(surface, 'keydown', {key: 'ArrowRight'}); current(1);
+  fire(surface, 'keydown', {key: 'ArrowLeft'}); current(0);
+  fire(surface, 'keydown', {key: 'End'}); current(3);
+  fire(surface, 'keydown', {key: 'Home'}); current(0);
+  fire(surface, 'keydown', {key: ' '}); current(1);
+  fire(surface, 'keydown', {key: ' ', shiftKey: true}); current(0);
+  assert(fire(nav, 'click', {target: links[2]}).defaultPrevented); current(2);
+  assert.equal(document.activeElement, slides[2]);
+  fire(nav, 'keydown', {key: 'ArrowRight'}); current(3);
+  fire(nav, 'keydown', {key: 'Home'}); current(0);
+  fire(nav, 'click', {target: links[2]}); current(2);
+  reading.matches = true; fire(reading, 'change'); isReading();
+  assert(!fire(nav, 'click', {target: links[1]}).defaultPrevented);
+  reading.matches = false; fire(reading, 'change'); current(2);
+  fire(window, 'beforeprint'); isReading();
+  fire(window, 'afterprint'); current(2);
+  assert.equal(surface.children.filter(c => c.tagName !== 'article').length, 1);
+  console.log(`PASS: ${startReading ? 'phone' : 'desktop'} startup, arrow/Home/End/Space handlers, navigation links, inactive focus guards, reading-mode cleanup, resize restoration, print lifecycle.`);
+}
+run(false);
+run(true);
+console.log('LIMIT: JavaScript state checks use a DOM harness; no browser pixels, actual Tab traversal, native printing or assistive technology were tested.');
