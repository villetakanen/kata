+// A small DOM harness exercises the shipped JavaScript without opening a browser.
+// It cannot test layout, rendering, native keyboard routing or a screen reader.
+function run(startReading) {
+  let scrollY = 0;
+  class Target {
+    constructor() { this.listeners = new Map(); }
+    addEventListener(type, callback, options) {
+      if (!this.listeners.has(type)) this.listeners.set(type, []);
+      this.listeners.get(type).push({callback, once: !!options?.once});
+    }
+    removeEventListener(type, callback) {
+      this.listeners.set(type, (this.listeners.get(type) || []).filter(e => e.callback !== callback));
+    }
+    dispatchEvent(event) {
+      event.target ||= this;
+      for (const listener of [...(this.listeners.get(event.type) || [])]) {
+        listener.callback(event);
+        if (listener.once) this.removeEventListener(event.type, listener.callback);
+      }
+      return true;
+    }
