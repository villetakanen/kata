+    closest(selector) { return selector === 'a' && this.tagName === 'a' ? this : null; }
+    querySelector(selector) {
+      if (selector.includes('h1')) return {textContent: this.id};
+      return null;
+    }
+    querySelectorAll(selector) {
+      if (selector === ':scope > article') return this.children.filter(c => c.tagName === 'article');
+      if (selector === 'a') return this.children;
+      return [];
+    }
+    getBoundingClientRect() { return {top: 64 + slides.indexOf(this) * 900 - scrollY}; }
+    scrollIntoView() { scrollY = slides.indexOf(this) * 900; }
+  }
+  const document = new Target();
+  document.readyState = 'loading'; document.documentElement = new Element('html');
+  const surface = new Element('div'); surface.setAttribute('aria-label', 'Mars Surface Power');
+  const ids = ['mars-surface-power', 'introduction', 'technology-trade-space', 'summary-of-decision'];
+  const slides = ids.map(id => { const e = new Element('article', id); e.dataset.transition = 'direct'; surface.appendChild(e); return e; });
+  const nav = new Element('nav');
+  const links = ids.map(id => { const e = new Element('a'); e.hash = '#' + id; nav.appendChild(e); return e; });
+  document.querySelector = query => query === '[data-lys]' ? surface : nav;
+  document.querySelectorAll = () => [surface]; document.createElement = tag => new Element(tag);
+  const window = new Target(); window.scrollTo = (x, y) => { scrollY = y; };
+  const reading = new Target(); reading.matches = startReading;
+  const location = {hash: ''};
+  class CustomEvent { constructor(type, init = {}) { this.type = type; Object.assign(this, init); } }
+  const context = vm.createContext({document, window, location, CustomEvent,
+    matchMedia: query => query.includes('max-width') ? reading : {matches: false},
+    history: {replaceState: (a, b, hash) => { location.hash = hash; }},
+    requestAnimationFrame: () => 1, cancelAnimationFrame: () => {}, console
+  });
+  vm.runInContext(fs.readFileSync('qa/lys-runtime-js.js', 'utf8'), context);
+  vm.runInContext(fs.readFileSync('qa/reading-mode-adapter.js', 'utf8'), context);
+  document.dispatchEvent({type: 'DOMContentLoaded'});
+  const fire = (target, type, extra = {}) => {
+    const event = {type, preventDefault() { this.defaultPrevented = true; }, ...extra};
+    target.dispatchEvent(event); return event;
+  };
+  const isReading = () => {
+    assert(!surface.hasAttribute('data-lys-mode'));
+    assert(!document.documentElement.classes.has('presentation'));
+    slides.forEach(s => { assert(!s.hasAttribute('aria-hidden')); assert(!s.inert); });
+  };
+  const current = index => {
+    assert.equal(surface.getAttribute('data-lys-current'), String(index));
+    slides.forEach((s, i) => {
+      assert.equal(s.hasAttribute('data-lys-active'), i === index);
+      assert.equal(s.getAttribute('aria-hidden'), i === index ? null : 'true');
+      assert.equal(s.inert, i !== index);
+      assert.equal(links[i].getAttribute('aria-current'), i === index ? 'page' : null);
+    });
+  };
+  if (startReading) { isReading(); reading.matches = false; fire(reading, 'change'); }
+  current(0);
+  fire(surface, 'keydown', {key: 'ArrowRight'}); current(1);
+  fire(surface, 'keydown', {key: 'ArrowLeft'}); current(0);
+  fire(surface, 'keydown', {key: 'End'}); current(3);
+  fire(surface, 'keydown', {key: 'Home'}); current(0);
+  fire(surface, 'keydown', {key: ' '}); current(1);
+  fire(surface, 'keydown', {key: ' ', shiftKey: true}); current(0);
+  assert(fire(nav, 'click', {target: links[2]}).defaultPrevented); current(2);
+  assert.equal(document.activeElement, slides[2]);
+  fire(nav, 'keydown', {key: 'ArrowRight'}); current(3);
+  fire(nav, 'keydown', {key: 'Home'}); current(0);
+  fire(nav, 'click', {target: links[2]}); current(2);
+  reading.matches = true; fire(reading, 'change'); isReading();
+  assert(!fire(nav, 'click', {target: links[1]}).defaultPrevented);
+  reading.matches = false; fire(reading, 'change'); current(2);
+  fire(window, 'beforeprint'); isReading();
+  fire(window, 'afterprint'); current(2);
+  assert.equal(surface.children.filter(c => c.tagName !== 'article').length, 1);
+  console.log(`PASS: ${startReading ? 'phone' : 'desktop'} startup, arrow/Home/End/Space handlers, navigation links, inactive focus guards, reading-mode cleanup, resize restoration, print lifecycle.`);
+}
+run(false);
+run(true);
+console.log('LIMIT: JavaScript state checks use a DOM harness; no browser pixels, actual Tab traversal, native printing or assistive technology were tested.');
diff --git a/qa/verify.py b/qa/verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..d63d0c9ff2416fc557a794c6d14b0bde9960d9eb
--- /dev/null
+++ b/qa/verify.py
@@ -0,0 +1,87 @@
+from html.parser import HTMLParser
+from pathlib import Path
+import json, re
+
+ROOT = Path(__file__).resolve().parent.parent
+source = (ROOT / 'output/slide.html').read_text()
+brief = (ROOT / 'inputs/brief.md').read_text()
+
+class Element:
+    def __init__(self, tag, attrs):
+        self.tag, self.attrs, self.children = tag, dict(attrs), []
+    def text(self):
+        return ''.join(c.text() if isinstance(c, Element) else c for c in self.children)
+    def all(self, tag):
+        result = []
+        for child in self.children:
+            if isinstance(child, Element):
+                if child.tag == tag: result.append(child)
+                result += child.all(tag)
+        return result
+
+class Parser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.root = Element('root', [])
+        self.stack = [self.root]
+    def handle_starttag(self, tag, attrs):
+        el = Element(tag, attrs)
+        self.stack[-1].children.append(el)
+        if tag == 'br': self.stack[-1].children.append(' ')
+        if tag not in {'meta', 'link', 'br', 'hr', 'img', 'input'}: self.stack.append(el)
+    def handle_endtag(self, tag):
+        assert self.stack[-1].tag == tag, (tag, self.stack[-1].tag)
+        self.stack.pop()
+    def handle_data(self, text): self.stack[-1].children.append(text)
+
+def normalize(text): return re.sub(r'\s+', ' ', text).strip()
+parser = Parser()
+parser.feed(source)
+root = parser.root
+articles = root.all('article')
+assert len(articles) == 4
+deck = next(el for el in root.all('div') if 'data-lys' in el.attrs)
+assert [el for el in deck.children if isinstance(el, Element)] == articles
+parts = re.split(r'## Slide \d[^\n]*\n', brief)[1:]
+for article, part in zip(articles, parts):
+    expected = []
+    for line in part.splitlines():
+        if line.strip(): expected.append(re.sub(r'^(Title: |- )', '', line).replace('~~', ''))
+    content = [child for child in article.children if not isinstance(child, Element) or child.tag != 'footer']
+    actual = normalize(''.join(child.text() if isinstance(child, Element) else child for child in content))
+    assert actual == normalize(' '.join(expected)), (article.attrs['id'], actual, expected)
+    assert article.attrs.get('data-notes')
+    assert any(article.all('h' + str(n)) for n in range(1, 7))
+
+expected_strikes = re.findall(r'~~(.*?)~~', brief)
+assert [el.text() for el in root.all('s')] == expected_strikes
+assert len(expected_strikes) == 6
+assert len(articles[2].all('h3')) == 2
+assert root.all('html')[0].attrs['lang'] == 'en'
+assert any(el.attrs.get('charset') == 'UTF-8' for el in root.all('meta'))
+assert any(el.attrs.get('name') == 'viewport' for el in root.all('meta'))
+assert (ROOT / 'inputs/lys/NOTICE.md').read_text() in source
+for file, id, tag in [('lys.css', 'lys-runtime-css', 'style'), ('lys.iife.js', 'lys-runtime-js', 'script')]:
+    actual = next(el.text() for el in root.all(tag) if el.attrs.get('id') == id)
+    assert actual.strip() == (ROOT / 'inputs/lys' / file).read_text().strip()
+for el in root.all('script'):
+    assert 'src' not in el.attrs
+    (ROOT / 'qa' / (el.attrs['id'] + '.js')).write_text(el.text())
+assert not root.all('link') and not root.all('img')
+assert not re.search(r'\son\w+\s*=', source)
+assert not re.search(r'<[^>]+\bdata-lys-(active|current|mode)\b', source)
+theme = next(el.text() for el in root.all('style') if el.attrs.get('id') == 'presentation-theme')
+assert '--_lys-' not in theme
+assert 'url(' not in theme and '@import' not in theme
+assert '@media print' in theme and 'break-after: page' in theme
+assert '@media screen and (max-width: 600px)' in theme
+assert '* { margin: 0; box-sizing: border-box; }' in theme
+
+decision = json.loads((ROOT / 'output/decision.json').read_text())
+assert set(decision) == {'protocol', 'audience_question', 'form', 'fit_rationale', 'tradeoff', 'caveats'}
+assert decision['protocol'] == 'kata-eval-decision/v1'
+assert decision['audience_question'] == 'What surface power technology did NASA select for initial crewed missions to Mars, and which technology categories were considered?'
+assert all(isinstance(decision[key], str) for key in decision if key != 'caveats')
+assert isinstance(decision['caveats'], list) and all(isinstance(v, str) for v in decision['caveats'])
+print('PASS: four slides in order; exact supplied wording; six exclusions; qualifiers; headings and notes; standalone runtime and notice; no external dependencies; decision schema.')
+print('SOURCE REVIEW ONLY: responsive, no-JavaScript and print CSS. No browser layout measurements or rendered visual checks performed.')

